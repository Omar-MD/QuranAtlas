{
  "name": "quran-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Distraction-free Quran reading PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "check-chunks": "node scripts/check-chunks.js",
    "lighthouse": "pnpm run build && lhci autorun --config=.lighthouserc.cjs",
    "mcp:cleanup": "rm -rf test-output"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.3"
    }
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "vite": "^8.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2",
    "workbox-build": "^7.4.0",
    "workbox-precaching": "^7.4.0"
  }
}
