{
  "name": "quran-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Distraction-free Quran reading PWA",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --strictPort",
    "clean": "rm -rf dist test-output",
    "build": "pnpm run data -- build && pnpm run ci:build",
    "ci:affected": "node scripts/ci/affected.mjs",
    "ci:build": "node scripts/ci/build.mjs",
    "data": "node scripts/data/cli.mjs",
    "data:fetch": "node scripts/data/fetch-source.mjs",
    "test": "vitest run",
    "test:fast": "vitest run --exclude tests/unit/scripts/search-builder.test.js --exclude tests/unit/scripts/search-morphology.test.mjs --exclude tests/unit/react-search/generated-pack-smoke.test.ts",
    "test:node": "vitest run --project=node",
    "test:react": "vitest run --project=react",
    "test:unit:full": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:preview": "node scripts/ci/e2e-preview.mjs",
    "test:e2e:golden": "node scripts/ci/e2e-preview.mjs --grep @golden",
    "test:e2e:offline": "node scripts/ci/e2e-preview.mjs --include-offline --grep @offline",
    "visual": "node scripts/ci/visual.mjs",
    "storybook": "storybook dev -p 6007 --config-dir .storybook",
    "build:storybook": "storybook build --config-dir .storybook --output-dir storybook-static",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "lint": "eslint src/ shared/ tests/e2e/**/*.ts tests/unit/react-*/ tests/unit/scripts/ tests/unit/shared/ .storybook/ playwright.config.js playwright.visual.config.js vite.config.js vitest.config.ts vitest.storybook.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "check:design": "node scripts/check-react-design-literals.mjs",
    "check:radix": "node scripts/check-react-radix-boundaries.mjs",
    "check:registry": "node scripts/check-react-component-registry.mjs",
    "check:ui-patterns": "node scripts/check-react-ui-forbidden-patterns.mjs",
    "check:mushaf-assets": "node scripts/check-react-mushaf-assets.mjs && node scripts/check-react-mushaf-indexes.mjs",
    "check:feature-state": "node scripts/check-no-feature-state.js",
    "check:ui-references": "node scripts/check-ui-references.mjs",
    "check": "node scripts/ci/check.mjs",
    "docs": "node scripts/docs/derive.mjs",
    "docs:check": "node scripts/docs/derive.mjs --check",
    "lighthouse": "pnpm run build && lhci autorun --config=.lighthouserc.cjs",
    "validate": "node scripts/ci/validate.mjs",
    "validate:affected": "node scripts/ci/validate-affected.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "overrides": {
      "serialize-javascript": "^7.0.3",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "basic-ftp": "^5.3.1",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "tmp": "^0.2.6",
      "uuid@<14.0.0": ">=14.0.0",
      "postcss@<8.5.10": ">=8.5.10",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/addon-vitest": "^10.4.1",
    "@storybook/react": "10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.5",
    "eslint": "^10.2.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "storybook": "^10.4.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "workbox-build": "^7.4.1",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "wrangler": "4.95.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  }
}
