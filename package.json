{
  "name": "quran-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Distraction-free Quran reading PWA",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview --strictPort",
    "clean": "rm -rf dist test-output",
    "build": "pnpm run data -- build && vite build",
    "data": "node scripts/data/cli.mjs",
    "data:fetch": "node scripts/data/fetch-source.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src/ && stylelint 'src/styles/**/*.css'",
    "check": "pnpm run lint && node scripts/check-theme-parity.mjs && node scripts/check-token-usage.mjs && node scripts/check-at-layer.mjs && node scripts/check-no-svelte-style.mjs && svelte-check --tsconfig ./tsconfig.json",
    "docs": "node scripts/docs/derive.mjs",
    "docs:check": "node scripts/docs/derive.mjs --check",
    "lighthouse": "pnpm run build && lhci autorun --config=.lighthouserc.cjs",
    "validate": "pnpm run check && node scripts/check-no-feature-state.js && pnpm run test && pnpm run build && node scripts/check-chunks.js && pnpm run docs:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.3",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "basic-ftp": "^5.3.1",
      "fast-uri": ">=3.1.2",
      "ip-address": ">=10.1.1",
      "tmp": "^0.2.4",
      "uuid@<14.0.0": ">=14.0.0",
      "postcss@<8.5.10": ">=8.5.10"
    },
    "patchedDependencies": {
      "vite-plugin-pwa@1.2.0": "patches/vite-plugin-pwa@1.2.0.patch"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "eslint-plugin-svelte": "^3.17.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.5",
    "workbox-build": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "dependencies": {
    "mitt": "^3.0.1"
  }
}
