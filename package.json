{
  "name": "quran-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Distraction-free Quran reading PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --strictPort",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:sw": "PLAYWRIGHT_USE_PREVIEW=1 playwright test tests/e2e/sw-integration.spec.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "check-chunks": "node scripts/check-chunks.js",
    "lighthouse": "pnpm run build && lhci autorun --config=.lighthouserc.cjs",
    "clean": "rm -rf dist test-output",
    "mcp:cleanup": "rm -rf test-output",
    "validate": "pnpm run lint && pnpm run test:run && pnpm run build && pnpm run check-chunks"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.31.0",
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.0.3"
    },
    "patchedDependencies": {
      "vite-plugin-pwa@1.2.0": "patches/vite-plugin-pwa@1.2.0.patch"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "vite": "^8.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.2",
    "workbox-build": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "dependencies": {
    "mitt": "^3.0.1"
  }
}
