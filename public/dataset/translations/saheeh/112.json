{"translationId":"saheeh","translationVersion":"quran-db-main","surahNo":112,"intro":[],"verses":[{"key":"112:1","text":"Say, \"He is Allah , [who is] One"},{"key":"112:2","text":"Allah , the Eternal Refuge"},{"key":"112:3","text":"He neither begets nor is born"},{"key":"112:4","text":"Nor is there to Him any equivalent.\""}],"footnotes":{}}