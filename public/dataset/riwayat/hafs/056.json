نَّ ٱلۡأَوَّلِينَ وَٱلۡأٓخِرِينَ ٤٩","aya_text_emlaey":"قل إن الأولين والآخرين"},{"id":5029,"jozz":27,"page":535,"line_start":15,"line_end":15,"aya_no":50,"aya_text":"لَمَجۡمُوعُونَ إِلَىٰ مِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ ٥٠","aya_text_emlaey":"لمجموعون إلى ميقات يوم معلوم"},{"id":5030,"jozz":27,"page":536,"line_start":1,"line_end":1,"aya_no":51,"aya_text":"ثُمَّ إِنَّكُمۡ أَيُّهَا ٱلضَّآلُّونَ ٱلۡمُكَذِّبُونَ ٥١","aya_text_emlaey":"ثم إنكم أيها الضالون المكذبون"},{"id":5031,"jozz":27,"page":536,"line_start":1,"line_end":1,"aya_no":52,"aya_text":"لَأٓكِلُونَ مِن شَجَرٖ مِّن زَقُّومٖ ٥٢","aya_text_emlaey":"لآكلون من شجر من زقوم"},{"id":5032,"jozz":27,"page":536,"line_start":2,"line_end":2,"aya_no":53,"aya_text":"فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٥٣","aya_text_emlaey":"فمالئون منها البطون"},{"id":5033,"jozz":27,"page":536,"line_start":2,"line_end":2,"aya_no":54,"aya_text":"فَشَٰرِبُونَ عَلَيۡهِ مِنَ ٱلۡحَمِيمِ ٥٤","aya_text_emlaey":"فشاربون عليه من الحميم"},{"id":5034,"jozz":27,"page":536,"line_start":2,"line_end":3,"aya_no":55,"aya_text":"فَشَٰرِبُونَ شُرۡبَ ٱلۡهِيمِ ٥٥","aya_text_emlaey":"فشاربون شرب الهيم"},{"id":5035,"jozz":27,"page":536,"line_start":3,"line_end":3,"aya_no":56,"aya_text":"هَٰذَا نُزُلُهُمۡ يَوۡمَ ٱلدِّينِ ٥٦","aya_text_emlaey":"هذا نزلهم يوم الدين"},{"id":5036,"jozz":27,"page":536,"line_start":3,"line_end":4,"aya_no":57,"aya_text":"نَحۡنُ خَلَقۡنَٰكُمۡ فَلَوۡلَا تُصَدِّقُونَ ٥٧","aya_text_emlaey":"نحن خلقناكم فلولا تصدقون"},{"id":5037,"jozz":27,"page":536,"line_start":4,"line_end":4,"aya_no":58,"aya_text":"أَفَرَءَيۡتُم مَّا تُمۡنُونَ ٥٨","aya_text_emlaey":"أفرأيتم ما تمنون"},{"id":5038,"jozz":27,"page":536,"line_start":4,"line_end":5,"aya_no":59,"aya_text":"ءَأَنتُمۡ تَخۡلُقُونَهُۥٓ أَمۡ نَحۡنُ ٱلۡخَٰلِقُونَ ٥٩","aya_text_emlaey":"أأنتم تخلقونه أم نحن الخالقون"},{"id":5039,"jozz":27,"page":536,"line_start":5,"line_end":5,"aya_no":60,"aya_text":"نَحۡنُ قَدَّرۡنَا بَيۡنَكُمُ ٱلۡمَوۡتَ وَمَا نَحۡنُ بِمَسۡبُوقِينَ ٦٠","aya_text_emlaey":"نحن قدرنا بينكم الموت وما نحن بمسبوقين"},{"id":5040,"jozz":27,"page":536,"line_start":6,"line_end":6,"aya_no":61,"aya_text":"عَلَىٰٓ أَن نُّبَدِّلَ أَمۡثَٰلَكُمۡ وَنُنشِئَكُمۡ فِي مَا لَا تَعۡلَمُونَ ٦١","aya_text_emlaey":"على أن نبدل أمثالكم وننشئكم في ما لا تعلمون"},{"id":5041,"jozz":27,"page":536,"line_start":6,"line_end":7,"aya_no":62,"aya_text":"وَلَقَدۡ عَلِمۡتُمُ ٱلنَّشۡأَةَ ٱلۡأُولَىٰ فَلَوۡلَا تَذَكَّرُونَ ٦٢","aya_text_emlaey":"ولقد علمتم النشأة الأولى فلولا تذكرون"},{"id":5042,"jozz":27,"page":536,"line_start":7,"line_end":8,"aya_no":63,"aya_text":"أَفَرَءَيۡتُم مَّا تَحۡرُثُونَ ٦٣","aya_text_emlaey":"أفرأيتم ما تحرثون"},{"id":5043,"jozz":27,"page":536,"line_start":8,"line_end":8,"aya_no":64,"aya_text":"ءَأَنتُمۡ تَزۡرَعُونَهُۥٓ أَمۡ نَحۡنُ ٱلزَّٰرِعُونَ ٦٤","aya_text_emlaey":"أأنتم تزرعونه أم نحن الزارعون"},{"id":5044,"jozz":27,"page":536,"line_start":8,"line_end":9,"aya_no":65,"aya_text":"لَوۡ نَشَآءُ لَجَعَلۡنَٰهُ حُطَٰمٗا فَظَلۡتُمۡ تَفَكَّهُونَ ٦٥","aya_text_emlaey":"لو نشاء لجعلناه حطاما فظلتم تفكهون"},{"id":5045,"jozz":27,"page":536,"line_start":9,"line_end":9,"aya_no":66,"aya_text":"إِنَّا لَمُغۡرَمُونَ ٦٦","aya_text_emlaey":"إنا لمغرمون"},{"id":5046,"jozz":27,"page":536,"line_start":9,"line_end":10,"aya_no":67,"aya_text":"بَلۡ نَحۡنُ مَحۡرُومُونَ ٦٧","aya_text_emlaey":"بل نحن محرومون"},{"id":5047,"jozz":27,"page":536,"line_start":10,"line_end":10,"aya_no":68,"aya_text":"أَفَرَءَيۡتُمُ ٱلۡمَآءَ ٱلَّذِي تَشۡرَبُونَ ٦٨","aya_text_emlaey":"أفرأيتم الماء الذي تشربون"},{"id":5048,"jozz":27,"page":536,"line_start":10,"line_end":11,"aya_no":69,"aya_text":"ءَأَنتُمۡ أَنزَلۡتُمُوهُ مِنَ ٱلۡمُزۡنِ أَمۡ نَحۡنُ ٱلۡمُنزِلُونَ ٦٩","aya_text_emlaey":"أأنتم أنزلتموه من المزن أم نحن المنزلون"},{"id":5049,"jozz":27,"page":536,"line_start":11,"line_end":12,"aya_no":70,"aya_text":"لَوۡ نَشَآءُ جَعَلۡنَٰهُ أُجَاجٗا فَلَوۡلَا تَشۡكُرُونَ ٧٠","aya_text_emlaey":"لو نشاء جعلناه أجاجا فلولا تشكرون"},{"id":5050,"jozz":27,"page":536,"line_start":12,"line_end":12,"aya_no":71,"aya_text":"أَفَرَءَيۡتُمُ ٱلنَّارَ ٱلَّتِي تُورُونَ ٧١","aya_text_emlaey":"أفرأيتم النار التي تورون"},{"id":5051,"jozz":27,"page":536,"line_start":12,"line_end":13,"aya_no":72,"aya_text":"ءَأَنتُمۡ أَنشَأۡتُمۡ شَجَرَتَهَآ أَمۡ نَحۡنُ ٱلۡمُنشِـُٔونَ ٧٢","aya_text_emlaey":"أأنتم أنشأتم شجرتها أم نحن المنشئون"},{"id":5052,"jozz":27,"page":536,"line_start":13,"line_end":14,"aya_no":73,"aya_text":"نَحۡنُ جَعَلۡنَٰهَا تَذۡكِرَةٗ وَمَتَٰعٗا لِّلۡمُقۡوِينَ ٧٣","aya_text_emlaey":"نحن جعلناها تذكرة ومتاعا للمقوين"},{"id":5053,"jozz":27,"page":536,"line_start":14,"line_end":14,"aya_no":74,"aya_text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٧٤","aya_text_emlaey":"فسبح باسم ربك العظيم"},{"id":5054,"jozz":27,"page":536,"line_start":14,"line_end":15,"aya_no":75,"aya_text":"۞ فَلَآ أُقۡسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ ٧٥","aya_text_emlaey":"فلا أقسم بمواقع النجوم"},{"id":5055,"jozz":27,"page":536,"line_start":15,"line_end":15,"aya_no":76,"aya_text":"وَإِنَّهُۥ لَقَسَمٞ لَّوۡ تَعۡلَمُونَ عَظِيمٌ ٧٦","aya_text_emlaey":"وإنه لقسم لو تعلمون عظيم"},{"id":5056,"jozz":27,"page":537,"line_start":1,"line_end":1,"aya_no":77,"aya_text":"إِنَّهُۥ لَقُرۡءَانٞ كَرِيمٞ ٧٧","aya_text_emlaey":"إنه لقرآن كريم"},{"id":5057,"jozz":27,"page":537,"line_start":1,"line_end":1,"aya_no":78,"aya_text":"فِي كِتَٰبٖ مَّكۡنُونٖ ٧٨","aya_text_emlaey":"في كتاب مكنون"},{"id":5058,"jozz":27,"page":537,"line_start":1,"line_end":2,"aya_no":79,"aya_text":"لَّا يَمَسُّهُۥٓ إِلَّا ٱلۡمُطَهَّرُونَ ٧٩","aya_text_emlaey":"لا يمسه إلا المطهرون"},{"id":5059,"jozz":27,"page":537,"line_start":2,"line_end":2,"aya_no":80,"aya_text":"تَنزِيلٞ مِّن رَّبِّ ٱلۡعَٰلَمِينَ ٨٠","aya_text_emlaey":"تنزيل من رب العالمين"},{"id":5060,"jozz":27,"page":537,"line_start":2,"line_end":3,"aya_no":81,"aya_text":"أَفَبِهَٰذَا ٱلۡحَدِيثِ أَنتُم مُّدۡهِنُونَ ٨١","aya_text_emlaey":"أفبهذا الحديث أنتم مدهنون"},{"id":5061,"jozz":27,"page":537,"line_start":3,"line_end":3,"aya_no":82,"aya_text":"وَتَجۡعَلُونَ رِزۡقَكُمۡ أَنَّكُمۡ تُكَذِّبُونَ ٨٢","aya_text_emlaey":"وتجعلون رزقكم أنكم تكذبون"},{"id":5062,"jozz":27,"page":537,"line_start":3,"line_end":4,"aya_no":83,"aya_text":"فَلَوۡلَآ إِذَا بَلَغَتِ ٱلۡحُلۡقُومَ ٨٣","aya_text_emlaey":"فلولا إذا بلغت الحلقوم"},{"id":5063,"jozz":27,"page":537,"line_start":4,"line_end":4,"aya_no":84,"aya_text":"وَأَنتُمۡ حِينَئِذٖ تَنظُرُونَ ٨٤","aya_text_emlaey":"وأنتم حينئذ تنظرون"},{"id":5064,"jozz":27,"page":537,"line_start":4,"line_end":5,"aya_no":85,"aya_text":"وَنَحۡنُ أَقۡرَبُ إِلَيۡهِ مِنكُمۡ وَلَٰكِن لَّا تُبۡصِرُونَ ٨٥","aya_text_emlaey":"ونحن أقرب إليه منكم ولكن لا تبصرون"},{"id":5065,"jozz":27,"page":537,"line_start":5,"line_end":5,"aya_no":86,"aya_text":"فَلَوۡلَآ إِن كُنتُمۡ غَيۡرَ مَدِينِينَ ٨٦","aya_text_emlaey":"فلولا إن كنتم غير مدينين"},{"id":5066,"jozz":27,"page":537,"line_start":6,"line_end":6,"aya_no":87,"aya_text":"تَرۡجِعُونَهَآ إِن كُنتُمۡ صَٰدِقِينَ ٨٧","aya_text_emlaey":"ترجعونها إن كنتم صادقين"},{"id":5067,"jozz":27,"page":537,"line_start":6,"line_end":6,"aya_no":88,"aya_text":"فَأَمَّآ إِن كَانَ مِنَ ٱلۡمُقَرَّبِينَ ٨٨","aya_text_emlaey":"فأما إن كان من المقربين"},{"id":5068,"jozz":27,"page":537,"line_start":7,"line_end":7,"aya_no":89,"aya_text":"فَرَوۡحٞ وَرَيۡحَانٞ وَجَنَّتُ نَعِيمٖ ٨٩","aya_text_emlaey":"فروح وريحان وجنة نعيم"},{"id":5069,"jozz":27,"page":537,"line_start":7,"line_end":8,"aya_no":90,"aya_text":"وَأَمَّآ إِن كَانَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩٠","aya_text_emlaey":"وأما إن كان من أصحاب اليمين"},{"id":5070,"jozz":27,"page":537,"line_start":8,"line_end":8,"aya_no":91,"aya_text":"فَسَلَٰمٞ لَّكَ مِنۡ أَصۡحَٰبِ ٱلۡيَمِينِ ٩١","aya_text_emlaey":"فسلام لك من أصحاب اليمين"},{"id":5071,"jozz":27,"page":537,"line_start":8,"line_end":9,"aya_no":92,"aya_text":"وَأَمَّآ إِن كَانَ مِنَ ٱلۡمُكَذِّبِينَ ٱلضَّآلِّينَ ٩٢","aya_text_emlaey":"وأما إن كان من المكذبين الضالين"},{"id":5072,"jozz":27,"page":537,"line_start":9,"line_end":9,"aya_no":93,"aya_text":"فَنُزُلٞ مِّنۡ حَمِيمٖ ٩٣","aya_text_emlaey":"فنزل من حميم"},{"id":5073,"jozz":27,"page":537,"line_start":9,"line_end":9,"aya_no":94,"aya_text":"وَتَصۡلِيَةُ جَحِيمٍ ٩٤","aya_text_emlaey":"وتصلية جحيم"},{"id":5074,"jozz":27,"page":537,"line_start":10,"line_end":10,"aya_no":95,"aya_text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلۡيَقِينِ ٩٥","aya_text_emlaey":"إن هذا لهو حق اليقين"},{"id":5075,"jozz":27,"page":537,"line_start":10,"line_end":10,"aya_no":96,"aya_text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ ٩٦","aya_text_emlaey":"فسبح باسم ربك العظيم"}]}