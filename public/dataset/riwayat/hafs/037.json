jozz":23,"page":449,"line_start":6,"line_end":6,"aya_no":88,"aya_text":"فَنَظَرَ نَظۡرَةٗ فِي ٱلنُّجُومِ ٨٨","aya_text_emlaey":"فنظر نظرة في النجوم"},{"id":3877,"jozz":23,"page":449,"line_start":7,"line_end":7,"aya_no":89,"aya_text":"فَقَالَ إِنِّي سَقِيمٞ ٨٩","aya_text_emlaey":"فقال إني سقيم"},{"id":3878,"jozz":23,"page":449,"line_start":7,"line_end":7,"aya_no":90,"aya_text":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ ٩٠","aya_text_emlaey":"فتولوا عنه مدبرين"},{"id":3879,"jozz":23,"page":449,"line_start":7,"line_end":8,"aya_no":91,"aya_text":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ ٩١","aya_text_emlaey":"فراغ إلى آلهتهم فقال ألا تأكلون"},{"id":3880,"jozz":23,"page":449,"line_start":8,"line_end":8,"aya_no":92,"aya_text":"مَا لَكُمۡ لَا تَنطِقُونَ ٩٢","aya_text_emlaey":"ما لكم لا تنطقون"},{"id":3881,"jozz":23,"page":449,"line_start":8,"line_end":9,"aya_no":93,"aya_text":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ ٩٣","aya_text_emlaey":"فراغ عليهم ضربا باليمين"},{"id":3882,"jozz":23,"page":449,"line_start":9,"line_end":9,"aya_no":94,"aya_text":"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ ٩٤","aya_text_emlaey":"فأقبلوا إليه يزفون"},{"id":3883,"jozz":23,"page":449,"line_start":9,"line_end":9,"aya_no":95,"aya_text":"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ ٩٥","aya_text_emlaey":"قال أتعبدون ما تنحتون"},{"id":3884,"jozz":23,"page":449,"line_start":10,"line_end":10,"aya_no":96,"aya_text":"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ ٩٦","aya_text_emlaey":"والله خلقكم وما تعملون"},{"id":3885,"jozz":23,"page":449,"line_start":10,"line_end":11,"aya_no":97,"aya_text":"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنٗا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ ٩٧","aya_text_emlaey":"قالوا ابنوا له بنيانا فألقوه في الجحيم"},{"id":3886,"jozz":23,"page":449,"line_start":11,"line_end":11,"aya_no":98,"aya_text":"فَأَرَادُواْ بِهِۦ كَيۡدٗا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ ٩٨","aya_text_emlaey":"فأرادوا به كيدا فجعلناهم الأسفلين"},{"id":3887,"jozz":23,"page":449,"line_start":12,"line_end":12,"aya_no":99,"aya_text":"وَقَالَ إِنِّي ذَ