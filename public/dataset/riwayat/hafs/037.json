{"riwayah":"hafs","version":"18","sura_no":37,"sura_name_ar":"الصَّافَات","sura_name_en":"Aṣ-Ṣāffāt","ayat":[{"id":3789,"jozz":23,"page":446,"line_start":3,"line_end":3,"aya_no":1,"aya_text":"وَٱلصَّٰٓفَّٰتِ صَفّٗا ١","aya_text_emlaey":"والصافات صفا"},{"id":3790,"jozz":23,"page":446,"line_start":3,"line_end":3,"aya_no":2,"aya_text":"فَٱلزَّٰجِرَٰتِ زَجۡرٗا ٢","aya_text_emlaey":"فالزاجرات زجرا"},{"id":3791,"jozz":23,"page":446,"line_start":3,"line_end":3,"aya_no":3,"aya_text":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا ٣","aya_text_emlaey":"فالتاليات ذكرا"},{"id":3792,"jozz":23,"page":446,"line_start":3,"line_end":4,"aya_no":4,"aya_text":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدٞ ٤","aya_text_emlaey":"إن إلهكم لواحد"},{"id":3793,"jozz":23,"page":446,"line_start":4,"line_end":4,"aya_no":5,"aya_text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ ٥","aya_text_emlaey":"رب السموات والأرض وما بينهما ورب المشارق"},{"id":3794,"jozz":23,"page":446,"line_start":4,"line_end":5,"aya_no":6,"aya_text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ ٦","aya_text_emlaey":"إنا زينا السماء الدنيا بزينة الكواكب"},{"id":3795,"jozz":23,"page":446,"line_start":5,"line_end":5,"aya_no":7,"aya_text":"وَحِفۡظٗا مِّن كُلِّ شَيۡطَٰنٖ مَّارِدٖ ٧","aya_text_emlaey":"وحفظا من كل شيطان مارد"},{"id":3796,"jozz":23,"page":446,"line_start":6,"line_end":6,"aya_no":8,"aya_text":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبٖ ٨","aya_text_emlaey":"لا يسمعون إلى الملإ الأعلى ويقذفون من كل جانب"},{"id":3797,"jozz":23,"page":446,"line_start":6,"line_end":7,"aya_no":9,"aya_text":"دُحُورٗاۖ وَلَهُمۡ عَذَابٞ وَاصِبٌ ٩","aya_text_emlaey":"دحورا ولهم عذاب واصب"},{"id":3798,"jozz":23,"page":446,"line_start":7,"line_end":7,"aya_no":10,"aya_text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابٞ ثَاقِبٞ ١٠","aya_text_emlaey":"إلا من خطف الخطفة فأتبعه شهاب ثاقب"},{"id":3799,"jozz":23,"page":446,"line_start":8,"line_end":8,"aya_no":11,"aya_text":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينٖ لَّازِبِۭ ١١","aya_text_emlaey":"فاستفتهم أهم أشد خلقا أم من خلقنا إنا خلقناهم من طين لازب"},{"id":3800,"jozz":23,"page":446,"line_start":9,"line_end":9,"aya_no":12,"aya_text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ ١٢","aya_text_emlaey":"بل عجبت ويسخرون"},{"id":3801,"jozz":23,"page":446,"line_start":9,"line_end":9,"aya_no":13,"aya_text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ ١٣","aya_text_emlaey":"وإذا ذكروا لا يذكرون"},{"id":3802,"jozz":23,"page":446,"line_start":9,"line_end":10,"aya_no":14,"aya_text":"وَإِذَا رَأَوۡاْ ءَايَةٗ يَسۡتَسۡخِرُونَ ١٤","aya_text_emlaey":"وإذا رأوا آية يستسخرون"},{"id":3803,"jozz":23,"page":446,"line_start":10,"line_end":10,"aya_no":15,"aya_text":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرٞ مُّبِينٌ ١٥","aya_text_emlaey":"وقالوا إن هذا إلا سحر مبين"},{"id":3804,"jozz":23,"page":446,"line_start":10,"line_end":11,"aya_no":16,"aya_text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ ١٦","aya_text_emlaey":"أئذا متنا وكنا ترابا وعظاما أئنا لمبعوثون"},{"id":3805,"jozz":23,"page":446,"line_start":11,"line_end":11,"aya_no":17,"aya_text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ ١٧","aya_text_emlaey":"أو آباؤنا الأولون"},{"id":3806,"jozz":23,"page":446,"line_start":11,"line_end":12,"aya_no":18,"aya_text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ ١٨","aya_text_emlaey":"قل نعم وأنتم داخرون"},{"id":3807,"jozz":23,"page":446,"line_start":12,"line_end":12,"aya_no":19,"aya_text":"فَإِنَّمَا هِيَ زَجۡرَةٞ وَٰحِدَةٞ فَإِذَا هُمۡ يَنظُرُونَ ١٩","aya_text_emlaey":"فإنما هي زجرة واحدة فإذا هم ينظرون"},{"id":3808,"jozz":23,"page":446,"line_start":12,"line_end":13,"aya_no":20,"aya_text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ ٢٠","aya_text_emlaey":"وقالوا ياويلنا هذا يوم الدين"},{"id":3809,"jozz":23,"page":446,"line_start":13,"line_end":13,"aya_no":21,"aya_text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ ٢١","aya_text_emlaey":"هذا يوم الفصل الذي كنتم به تكذبون"},{"id":3810,"jozz":23,"page":446,"line_start":14,"line_end":14,"aya_no":22,"aya_text":"۞ ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ ٢٢","aya_text_emlaey":"احشروا الذين ظلموا وأزواجهم وما كانوا يعبدون"},{"id":3811,"jozz":23,"page":446,"line_start":14,"line_end":15,"aya_no":23,"aya_text":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ ٢٣","aya_text_emlaey":"من دون الله فاهدوهم إلى صراط الجحيم"},{"id":3812,"jozz":23,"page":446,"line_start":15,"line_end":15,"aya_no":24,"aya_text":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ ٢٤","aya_text_emlaey":"وقفوهم إنهم مسئولون"},{"id":3813,"jozz":23,"page":447,"line_start":1,"line_end":1,"aya_no":25,"aya_text":"مَا لَكُمۡ لَا تَنَاصَرُونَ ٢٥","aya_text_emlaey":"ما لكم لا تناصرون"},{"id":3814,"jozz":23,"page":447,"line_start":1,"line_end":1,"aya_no":26,"aya_text":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ ٢٦","aya_text_emlaey":"بل هم اليوم مستسلمون"},{"id":3815,"jozz":23,"page":447,"line_start":1,"line_end":2,"aya_no":27,"aya_text":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٢٧","aya_text_emlaey":"وأقبل بعضهم على بعض يتساءلون"},{"id":3816,"jozz":23,"page":447,"line_start":2,"line_end":2,"aya_no":28,"aya_text":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ ٢٨","aya_text_emlaey":"قالوا إنكم كنتم تأتوننا عن اليمين"},{"id":3817,"jozz":23,"page":447,"line_start":3,"line_end":3,"aya_no":29,"aya_text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ ٢٩","aya_text_emlaey":"قالوا بل لم تكونوا مؤمنين"},{"id":3818,"jozz":23,"page":447,"line_start":3,"line_end":4,"aya_no":30,"aya_text":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمٗا طَٰغِينَ ٣٠","aya_text_emlaey":"وما كان لنا عليكم من سلطان بل كنتم قوما طاغين"},{"id":3819,"jozz":23,"page":447,"line_start":4,"line_end":4,"aya_no":31,"aya_text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ ٣١","aya_text_emlaey":"فحق علينا قول ربنا إنا لذائقون"},{"id":3820,"jozz":23,"page":447,"line_start":5,"line_end":5,"aya_no":32,"aya_text":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ ٣٢","aya_text_emlaey":"فأغويناكم إنا كنا غاوين"},{"id":3821,"jozz":23,"page":447,"line_start":5,"line_end":6,"aya_no":33,"aya_text":"فَإِنَّهُمۡ يَوۡمَئِذٖ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ ٣٣","aya_text_emlaey":"فإنهم يومئذ في العذاب مشتركون"},{"id":3822,"jozz":23,"page":447,"line_start":6,"line_end":6,"aya_no":34,"aya_text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ ٣٤","aya_text_emlaey":"إنا كذلك نفعل بالمجرمين"},{"id":3823,"jozz":23,"page":447,"line_start":6,"line_end":7,"aya_no":35,"aya_text":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ ٣٥","aya_text_emlaey":"إنهم كانوا إذا قيل لهم لا إله إلا الله يستكبرون"},{"id":3824,"jozz":23,"page":447,"line_start":7,"line_end":8,"aya_no":36,"aya_text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرٖ مَّجۡنُونِۭ ٣٦","aya_text_emlaey":"ويقولون أئنا لتاركوا آلهتنا لشاعر مجنون"},{"id":3825,"jozz":23,"page":447,"line_start":8,"line_end":8,"aya_no":37,"aya_text":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ ٣٧","aya_text_emlaey":"بل جاء بالحق وصدق المرسلين"},{"id":3826,"jozz":23,"page":447,"line_start":8,"line_end":9,"aya_no":38,"aya_text":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ ٣٨","aya_text_emlaey":"إنكم لذائقوا العذاب الأليم"},{"id":3827,"jozz":23,"page":447,"line_start":9,"line_end":9,"aya_no":39,"aya_text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ ٣٩","aya_text_emlaey":"وما تجزون إلا ما كنتم تعملون"},{"id":3828,"jozz":23,"page":447,"line_start":10,"line_end":10,"aya_no":40,"aya_text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٤٠","aya_text_emlaey":"إلا عباد الله المخلصين"},{"id":3829,"jozz":23,"page":447,"line_start":10,"line_end":10,"aya_no":41,"aya_text":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقٞ مَّعۡلُومٞ ٤١","aya_text_emlaey":"أولئك لهم رزق معلوم"},{"id":3830,"jozz":23,"page":447,"line_start":10,"line_end":11,"aya_no":42,"aya_text":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ ٤٢","aya_text_emlaey":"فواكه وهم مكرمون"},{"id":3831,"jozz":23,"page":447,"line_start":11,"line_end":11,"aya_no":43,"aya_text":"فِي جَنَّٰتِ ٱلنَّعِيمِ ٤٣","aya_text_emlaey":"في جنات النعيم"},{"id":3832,"jozz":23,"page":447,"line_start":11,"line_end":11,"aya_no":44,"aya_text":"عَلَىٰ سُرُرٖ مُّتَقَٰبِلِينَ ٤٤","aya_text_emlaey":"على سرر متقابلين"},{"id":3833,"jozz":23,"page":447,"line_start":12,"line_end":12,"aya_no":45,"aya_text":"يُطَافُ عَلَيۡهِم بِكَأۡسٖ مِّن مَّعِينِۭ ٤٥","aya_text_emlaey":"يطاف عليهم بكأس من معين"},{"id":3834,"jozz":23,"page":447,"line_start":12,"line_end":12,"aya_no":46,"aya_text":"بَيۡضَآءَ لَذَّةٖ لِّلشَّٰرِبِينَ ٤٦","aya_text_emlaey":"بيضاء لذة للشاربين"},{"id":3835,"jozz":23,"page":447,"line_start":13,"line_end":13,"aya_no":47,"aya_text":"لَا فِيهَا غَوۡلٞ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ ٤٧","aya_text_emlaey":"لا فيها غول ولا هم عنها ينزفون"},{"id":3836,"jozz":23,"page":447,"line_start":13,"line_end":14,"aya_no":48,"aya_text":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينٞ ٤٨","aya_text_emlaey":"وعندهم قاصرات الطرف عين"},{"id":3837,"jozz":23,"page":447,"line_start":14,"line_end":14,"aya_no":49,"aya_text":"كَأَنَّهُنَّ بَيۡضٞ مَّكۡنُونٞ ٤٩","aya_text_emlaey":"كأنهن بيض مكنون"},{"id":3838,"jozz":23,"page":447,"line_start":14,"line_end":15,"aya_no":50,"aya_text":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضٖ يَتَسَآءَلُونَ ٥٠","aya_text_emlaey":"فأقبل بعضهم على بعض يتساءلون"},{"id":3839,"jozz":23,"page":447,"line_start":15,"line_end":15,"aya_no":51,"aya_text":"قَالَ قَآئِلٞ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينٞ ٥١","aya_text_emlaey":"قال قائل منهم إني كان لي قرين"},{"id":3840,"jozz":23,"page":448,"line_start":1,"line_end":1,"aya_no":52,"aya_text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ ٥٢","aya_text_emlaey":"يقول أئنك لمن المصدقين"},{"id":3841,"jozz":23,"page":448,"line_start":1,"line_end":2,"aya_no":53,"aya_text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابٗا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ ٥٣","aya_text_emlaey":"أئذا متنا وكنا ترابا وعظاما أئنا لمدينون"},{"id":3842,"jozz":23,"page":448,"line_start":2,"line_end":2,"aya_no":54,"aya_text":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ ٥٤","aya_text_emlaey":"قال هل أنتم مطلعون"},{"id":3843,"jozz":23,"page":448,"line_start":2,"line_end":3,"aya_no":55,"aya_text":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ ٥٥","aya_text_emlaey":"فاطلع فرآه في سواء الجحيم"},{"id":3844,"jozz":23,"page":448,"line_start":3,"line_end":3,"aya_no":56,"aya_text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ ٥٦","aya_text_emlaey":"قال تالله إن كدت لتردين"},{"id":3845,"jozz":23,"page":448,"line_start":3,"line_end":4,"aya_no":57,"aya_text":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ ٥٧","aya_text_emlaey":"ولولا نعمة ربي لكنت من المحضرين"},{"id":3846,"jozz":23,"page":448,"line_start":4,"line_end":4,"aya_no":58,"aya_text":"أَفَمَا نَحۡنُ بِمَيِّتِينَ ٥٨","aya_text_emlaey":"أفما نحن بميتين"},{"id":3847,"jozz":23,"page":448,"line_start":4,"line_end":5,"aya_no":59,"aya_text":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ ٥٩","aya_text_emlaey":"إلا موتتنا الأولى وما نحن بمعذبين"},{"id":3848,"jozz":23,"page":448,"line_start":5,"line_end":5,"aya_no":60,"aya_text":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ ٦٠","aya_text_emlaey":"إن هذا لهو الفوز العظيم"},{"id":3849,"jozz":23,"page":448,"line_start":6,"line_end":6,"aya_no":61,"aya_text":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ ٦١","aya_text_emlaey":"لمثل هذا فليعمل العاملون"},{"id":3850,"jozz":23,"page":448,"line_start":6,"line_end":7,"aya_no":62,"aya_text":"أَذَٰلِكَ خَيۡرٞ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ ٦٢","aya_text_emlaey":"أذلك خير نزلا أم شجرة الزقوم"},{"id":3851,"jozz":23,"page":448,"line_start":7,"line_end":7,"aya_no":63,"aya_text":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةٗ لِّلظَّٰلِمِينَ ٦٣","aya_text_emlaey":"إنا جعلناها فتنة للظالمين"},{"id":3852,"jozz":23,"page":448,"line_start":7,"line_end":8,"aya_no":64,"aya_text":"إِنَّهَا شَجَرَةٞ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ ٦٤","aya_text_emlaey":"إنها شجرة تخرج في أصل الجحيم"},{"id":3853,"jozz":23,"page":448,"line_start":8,"line_end":8,"aya_no":65,"aya_text":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ ٦٥","aya_text_emlaey":"طلعها كأنه رءوس الشياطين"},{"id":3854,"jozz":23,"page":448,"line_start":9,"line_end":9,"aya_no":66,"aya_text":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ ٦٦","aya_text_emlaey":"فإنهم لآكلون منها فمالئون منها البطون"},{"id":3855,"jozz":23,"page":448,"line_start":9,"line_end":10,"aya_no":67,"aya_text":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبٗا مِّنۡ حَمِيمٖ ٦٧","aya_text_emlaey":"ثم إن لهم عليها لشوبا من حميم"},{"id":3856,"jozz":23,"page":448,"line_start":10,"line_end":10,"aya_no":68,"aya_text":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ ٦٨","aya_text_emlaey":"ثم إن مرجعهم لإلى الجحيم"},{"id":3857,"jozz":23,"page":448,"line_start":11,"line_end":11,"aya_no":69,"aya_text":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ ٦٩","aya_text_emlaey":"إنهم ألفوا آباءهم ضالين"},{"id":3858,"jozz":23,"page":448,"line_start":11,"line_end":11,"aya_no":70,"aya_text":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ ٧٠","aya_text_emlaey":"فهم على آثارهم يهرعون"},{"id":3859,"jozz":23,"page":448,"line_start":12,"line_end":12,"aya_no":71,"aya_text":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ ٧١","aya_text_emlaey":"ولقد ضل قبلهم أكثر الأولين"},{"id":3860,"jozz":23,"page":448,"line_start":12,"line_end":13,"aya_no":72,"aya_text":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ ٧٢","aya_text_emlaey":"ولقد أرسلنا فيهم منذرين"},{"id":3861,"jozz":23,"page":448,"line_start":13,"line_end":13,"aya_no":73,"aya_text":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ ٧٣","aya_text_emlaey":"فانظر كيف كان عاقبة المنذرين"},{"id":3862,"jozz":23,"page":448,"line_start":14,"line_end":14,"aya_no":74,"aya_text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ ٧٤","aya_text_emlaey":"إلا عباد الله المخلصين"},{"id":3863,"jozz":23,"page":448,"line_start":14,"line_end":15,"aya_no":75,"aya_text":"وَلَقَدۡ نَادَىٰنَا نُوحٞ فَلَنِعۡمَ ٱلۡمُجِيبُونَ ٧٥","aya_text_emlaey":"ولقد نادانا نوح فلنعم المجيبون"},{"id":3864,"jozz":23,"page":448,"line_start":15,"line_end":15,"aya_no":76,"aya_text":"وَنَجَّيۡنَٰهُ وَأَهۡ