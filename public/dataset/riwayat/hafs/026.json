{"riwayah":"hafs","version":"18","sura_no":26,"sura_name_ar":"الشعراء","sura_name_en":"Ash-Shu‘arā’","ayat":[{"jozz":19,"page":367,"aya_no":1,"aya_text":"طسٓمٓ","id":2933,"line_start":3,"line_end":3},{"jozz":19,"page":367,"aya_no":2,"aya_text":"تِلۡكَ ءَايَٰتُ ٱلۡكِتَٰبِ ٱلۡمُبِينِ","id":2934,"line_start":3,"line_end":3},{"jozz":19,"page":367,"aya_no":3,"aya_text":"لَعَلَّكَ بَٰخِعٞ نَّفۡسَكَ أَلَّا يَكُونُواْ مُؤۡمِنِينَ","id":2935,"line_start":3,"line_end":4},{"jozz":19,"page":367,"aya_no":4,"aya_text":"إِن نَّشَأۡ نُنَزِّلۡ عَلَيۡهِم مِّنَ ٱلسَّمَآءِ ءَايَةٗ فَظَلَّتۡ أَعۡنَٰقُهُمۡ لَهَا خَٰضِعِينَ","id":2936,"line_start":4,"line_end":5},{"jozz":19,"page":367,"aya_no":5,"aya_text":"وَمَا يَأۡتِيهِم مِّن ذِكۡرٖ مِّنَ ٱلرَّحۡمَٰنِ مُحۡدَثٍ إِلَّا كَانُواْ عَنۡهُ مُعۡرِضِينَ","id":2937,"line_start":5,"line_end":6},{"jozz":19,"page":367,"aya_no":6,"aya_text":"فَقَدۡ كَذَّبُواْ فَسَيَأۡتِيهِمۡ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسۡتَهۡزِءُونَ","id":2938,"line_start":6,"line_end":7},{"jozz":19,"page":367,"aya_no":7,"aya_text":"أَوَلَمۡ يَرَوۡاْ إِلَى ٱلۡأَرۡضِ كَمۡ أَنۢبَتۡنَا فِيهَا مِن كُلِّ زَوۡجٖ كَرِيمٍ","id":2939,"line_start":7,"line_end":7},{"jozz":19,"page":367,"aya_no":8,"aya_text":"إِنَّ فِي ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكۡثَرُهُم مُّؤۡمِنِينَ","id":2940,"line_start":8,"line_end":8},{"jozz":19,"page":367,"aya_no":9,"aya_text":"وَإِنَّ رَبَّكَ لَهُوَ ٱلۡعَزِيزُ ٱلرَّحِيمُ","id":2941,"line_start":8,"line_end":9},{"jozz":19,"page":367,"aya_no":10,"aya_text":"وَإِذۡ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئۡتِ ٱلۡقَوۡمَ ٱلظَّٰلِمِينَ","id":2942,"line_start":9,"line_end":9},{"jozz":19,"page":367,"aya_no":11,"aya_text":"قَوۡمَ فِرۡعَوۡنَۚ أَلَا يَتَّقُونَ","id":2943,"line_start":9,"line_end":10},{"jozz":19,"page":367,"aya_no":12,"aya_text":"قَالَ رَبِّ إِنِّيٓ أَخَافُ أَن يُكَذِّبُونِ","id":2944,"line_start":10,"line_end":10},{"jozz":19,"page":367,"aya_no":13,"aya_text":"وَيَضِيقُ صَدۡرِي وَلَا يَنطَلِقُ لِسَانِي فَأَرۡسِلۡ إِلَىٰ هَٰرُونَ","id":2945,"line_start":10,"line_end":11},{"jozz":19,"page":367,"aya_no":14,"aya_text":"وَلَهُمۡ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَن يَقۡتُلُونِ","id":2946,"line_start":11,"line_end":12},{"jozz":19,"page":367,"aya_no":15,"aya_text":"قَالَ كـَلَّاۖ فَٱذۡهَبَا بِـَٔايَٰتِنَآۖ إِنَّا مَعَكُم مُّسۡتَمِعُونَ","id":2947,"line_start":12,"line_end":12},{"jozz":19,"page":367,"aya_no":16,"aya_text":"فَأۡتِيَا فِرۡعَوۡنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ ٱلۡعَٰلَمِينَ","id":2948,"line_start":13,"line_end":13},{"jozz":19,"page":367,"aya_no":17,"aya_text":"أَنۡ أَرۡسِلۡ مَعَنَا بَنِيٓ إِسۡرَٰٓءِيلَ","id":2949,"line_start":13,"line_end":14},{"jozz":19,"page":367,"aya_no":18,"aya_text":"قَالَ أَلَمۡ نُرَبِّكَ فِينَا وَلِيدٗا وَلَبِثۡتَ فِينَا مِنۡ عُمُرِكَ سِنِينَ","id":2950,"line_start":14,"line_end":15},{"jozz":19,"page":367,"aya_no":19,"aya_text":"وَفَعَلۡتَ فَعۡلَتَكَ ٱلَّتِي فَعَلۡتَ وَأَنتَ مِنَ ٱلۡكَٰفِرِينَ","id":2951,"line_start":15,"line_end":15},{"jozz":19,"page":368,"aya_no":20,"aya_text":"قَالَ فَعَلۡتُهَآ إِذٗا وَأَنَا۠ مِنَ ٱلضَّآلِّينَ","id":2952,"line_start":1,"line_end":1},{"jozz":19,"page":368,"aya_no":21,"aya_text":"فَفَرَرۡتُ مِنكُمۡ لَمَّا خِفۡتُكُمۡ فَوَهَبَ لِي رَبِّي حُكۡمٗا وَجَعَلَنِي مِنَ ٱلۡمُرۡسَلِينَ","id":2953,"line_start":1,"line_end":2},{"jozz":19,"page":368,"aya_no":22,"aya_text":"وَتِلۡكَ نِعۡمَةٞ تَمُنُّهَا عَلَيَّ أَنۡ عَبَّدتَّ بَنِيٓ إِسۡرَٰٓءِيلَ","id":2954,"line_start":2,"line_end":3},{"jozz":19,"page":368,"aya_no":23,"aya_text":"قَالَ فِرۡعَوۡنُ وَمَا رَبُّ ٱلۡعَٰلَمِينَ","id":2955,"line_start":3,"line_end":3},{"jozz":19,"page":368,"aya_no":24,"aya_text":"قَالَ رَبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُم مُّوقِنِينَ","id":2956,"line_start":4,"line_end":4},{"jozz":19,"page":368,"aya_no":25,"aya_text":"قَالَ لِمَنۡ حَوۡلَهُۥٓ أَلَا تَسۡتَمِعُونَ","id":2957,"line_start":5,"line_end":5},{"jozz":19,"page":368,"aya_no":26,"aya_text":"قَالَ رَبُّكُمۡ وَرَبُّ ءَابَآئِكُمُ ٱلۡأَوَّلِينَ","id":2958,"line_start":5,"line_end":6},{"jozz":19,"page":368,"aya_no":27,"aya_text":"قَالَ إِنَّ رَسُولَكُمُ ٱلَّذِيٓ أُرۡسِلَ إِلَيۡكُمۡ لَمَجۡنُونٞ","id":2959,"line_start":6,"line_end":6},{"jozz":19,"page":368,"aya_no":28,"aya_text":"قَالَ رَبُّ ٱلۡمَشۡرِقِ وَٱلۡمَغۡرِبِ وَمَا بَيۡنَهُمَآۖ إِن كُنتُمۡ تَعۡقِلُونَ","id":2960,"line_start":7,"line_end":7},{"jozz":19,"page":368,"aya_no":29,"aya_text":"قَالَ لَئِنِ ٱتَّخَذۡتَ إِلَٰهًا غَيۡرِي لَأَجۡعَلَنَّكَ مِنَ ٱلۡمَسۡجُونِينَ","id":2961,"line_start":8,"line_end":8},{"jozz":19,"page":368,"aya_no":30,"aya_text":"قَالَ أَوَلَوۡ جِئۡتُكَ بِشَيۡءٖ مُّبِينٖ","id":2962,"line_start":9,"line_end":9},{"jozz":19,"page":368,"aya_no":31,"aya_text":"قَالَ فَأۡتِ بِهِۦٓ إِن كُنتَ مِنَ ٱلصَّٰدِقِينَ","id":2963,"line_start":9,"line_end":10},{"jozz":19,"page":368,"aya_no":32,"aya_text":"فَأَلۡقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعۡبَانٞ مُّبِينٞ","id":2964,"line_start":10,"line_end":10},{"jozz":19,"page":368,"aya_no":33,"aya_text":"وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيۡضَآءُ لِلنَّٰظِرِينَ","id":2965,"line_start":11,"line_end":11},{"jozz":19,"page":368,"aya_no":34,"aya_text":"قَالَ لِلۡمَلَإِ حَوۡلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ","id":2966,"line_start":11,"line_end":12},{"jozz":19,"page":368,"aya_no":35,"aya_text":"يُرِيدُ أَن يُخۡرِجَكُم مِّنۡ أَرۡضِكُم بِسِحۡرِهِۦ فَمَاذَا تَأۡمُرُونَ","id":2967,"line_start":12,"line_end":13},{"jozz":19,"page":368,"aya_no":36,"aya_text":"قَالُوٓاْ أَرۡجِهۡ وَأَخَاهُ وَٱبۡعَثۡ فِي ٱلۡمَدَآئِنِ حَٰشِرِينَ","id":2968,"line_start":13,"line_end":14},{"jozz":19,"page":368,"aya_no":37,"aya_text":"يَأۡتُوكَ بِكُلِّ سَحَّارٍ عَلِيمٖ","id":2969,"line_start":14,"line_end":14},{"jozz":19,"page":368,"aya_no":38,"aya_text":"فَجُمِعَ ٱلسَّحَرَةُ لِمِيقَٰتِ يَوۡمٖ مَّعۡلُومٖ","id":2970,"line_start":14,"line_end":15},{"jozz":19,"page":368,"aya_no":39,"aya_text":"وَقِيلَ لِلنَّاسِ هَلۡ أَنتُم مُّجۡتَمِعُونَ","id":2971,"line_start":15,"line_end":15},{"jozz":19,"page":369,"aya_no":40,"aya_text":"لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُواْ هُمُ ٱلۡغَٰلِبِينَ","id":2972,"line_start":1,"line_end":1},{"