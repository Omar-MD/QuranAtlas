{"riwayah":"hafs","version":"18","sura_no":88,"sura_name_ar":"الغَاشِية","sura_name_en":"Al-Ghāshiyah","ayat":[{"id":5968,"jozz":30,"page":592,"line_start":7,"line_end":7,"aya_no":1,"aya_text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡغَٰشِيَةِ","aya_text_emlaey":"هل أتاك حديث الغاشية"},{"id":5969,"jozz":30,"page":592,"line_start":7,"line_end":7,"aya_no":2,"aya_text":"وُجُوهٞ يَوۡمَئِذٍ خَٰشِعَةٌ","aya_text_emlaey":"وجوه يومئذ خاشعة"},{"id":5970,"jozz":30,"page":592,"line_start":7,"line_end":8,"aya_no":3,"aya_text":"عَامِلَةٞ نَّاصِبَةٞ","aya_text_emlaey":"عاملة ناصبة"},{"id":5971,"jozz":30,"page":592,"line_start":8,"line_end":8,"aya_no":4,"aya_text":"تَصۡلَىٰ نَارًا حَامِيَةٗ","aya_text_emlaey":"تصلى نارا حامية"},{"id":5972,"jozz":30,"page":592,"line_start":8,"line_end":8,"aya_no":5,"aya_text":"تُسۡقَىٰ مِنۡ عَيۡنٍ ءَانِيَةٖ","aya_text_emlaey":"تسقى من عين آنية"},{"id":5973,"jozz":30,"page":592,"line_start":8,"line_end":9,"aya_no":6,"aya_text":"لَّيۡسَ لَهُمۡ طَعَامٌ إِلَّا مِن ضَرِيعٖ","aya_text_emlaey":"ليس لهم طعام إلا من ضريع"},{"id":5974,"jozz":30,"page":592,"line_start":9,"line_end":9,"aya_no":7,"aya_text":"لَّا يُسۡمِنُ وَلَا يُغۡنِي مِن جُوعٖ","aya_text_emlaey":"لا يسمن ولا يغني من جوع"},{"id":5975,"jozz":30,"page":592,"line_start":9,"line_end":10,"aya_no":8,"aya_text":"وُجُوهٞ يَوۡمَئِذٖ نَّاعِمَةٞ","aya_text_emlaey":"وجوه يومئذ ناعمة"},{"id":5976,"jozz":30,"page":592,"line_start":10,"line_end":10,"aya_no":9,"aya_text":"لِّسَعۡيِهَا رَاضِيَةٞ","aya_text_emlaey":"لسعيها راضية"},{"id":5977,"jozz":30,"page":592,"line_start":10,"line_end":10,"aya_no":10,"aya_text":"فِي جَنَّةٍ عَالِيَةٖ","aya_text_emlaey":"في جنة عالية"},{"id":5978,"jozz":30,"page":592,"line_start":10,"line_end":11,"aya_no":11,"aya_text":"لَّا تَسۡمَعُ فِيهَا لَٰغِيَةٗ","aya_text_emlaey":"لا تسمع فيها لاغية"},{"id":5979,"jozz":30,"page":592,"line_start":11,"line_end":11,"aya_no":12,"aya_text":"فِيهَا عَيۡنٞ جَارِيَةٞ","aya_text_emlaey":"فيها عين جارية"},{"id":5980,"jozz":30,"page":592,"line_start":11,"line_en