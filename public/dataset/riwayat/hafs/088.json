 إلينا إيابهم"},{"id":5993,"jozz":30,"page":593,"line_start":2,"line_end":2,"aya_no":26,"aya_text":"ثُمَّ إِنَّ عَلَيۡنَا حِسَابَهُم","aya_text_emlaey":"ثم إن علينا حسابهم"}]}