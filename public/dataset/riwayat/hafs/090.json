{"riwayah":"hafs","version":"18","sura_no":90,"sura_name_ar":"البَلَد","sura_name_en":"Al-Balad","ayat":[{"id":6024,"jozz":30,"page":594,"line_start":8,"line_end":8,"aya_no":1,"aya_text":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ ١","aya_text_emlaey":"لا أقسم بهذا البلد"},{"id":6025,"jozz":30,"page":594,"line_start":8,"line_end":8,"aya_no":2,"aya_text":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ ٢","aya_text_emlaey":"وأنت حل بهذا البلد"},{"id":6026,"jozz":30,"page":594,"line_start":8,"line_end":8,"aya_no":3,"aya_text":"وَوَالِدٖ وَمَا وَلَدَ ٣","aya_text_emlaey":"ووالد وما ولد"},{"id":6027,"jozz":30,"page":594,"line_start":9,"line_end":9,"aya_no":4,"aya_text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ ٤","aya_text_emlaey":"لقد خلقنا الإنسان في كبد"},{"id":6028,"jozz":30,"page":594,"line_start":9,"line_end":10,"aya_no":5,"aya_text":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدٞ ٥","aya_text_emlaey":"أيحسب أن لن يقدر عليه أحد"},{"id":6029,"jozz":30,"page":594,"line_start":10,"line_end":10,"aya_no":6,"aya_text":"يَقُولُ أَهۡلَكۡتُ مَالٗا لُّبَدًا ٦","aya_text_emlaey":"يقول أهلكت مالا لبدا"},{"id":6030,"jozz":30,"page":594,"line_start":10,"line_end":10,"aya_no":7,"aya_text":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ ٧","aya_text_emlaey":"أيحسب أن لم يره أحد"},{"id":6031,"jozz":30,"page":594,"line_start":11,"line_end":11,"aya_no":8,"aya_text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ ٨","aya_text_emlaey":"ألم نجعل له عينين"},{"id":6032,"jozz":30,"page":594,"line_start":11,"line_end":11,"aya_no":9,"aya_text":"وَلِسَانٗا وَشَفَتَيۡنِ ٩","aya_text_emlaey":"ولسانا وشفتين"},{"id":6033,"jozz":30,"page":594,"line_start":11,"line_end":12,"aya_no":10,"aya_text":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ ١٠","aya_text_emlaey":"وهديناه النجدين"},{"id":6034,"jozz":30,"page":594,"line_start":12,"line_end":12,"aya_no":11,"aya_text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ ١١","aya_text_emlaey":"فلا اقتحم العقبة"},{"id":6035,"jozz":30,"page":594,"line_start":12,"line_end":12,"aya_no":12,"aya_text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ ١٢","aya_tex