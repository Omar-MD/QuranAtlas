ُكَرَّمَةٖ ١٣","aya_text_emlaey":"في صحف مكرمة"},{"id":5772,"jozz":30,"page":585,"line_start":6,"line_end":7,"aya_no":14,"aya_text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ ١٤","aya_text_emlaey":"مرفوعة مطهرة"},{"id":5773,"jozz":30,"page":585,"line_start":7,"line_end":7,"aya_no":15,"aya_text":"بِأَيۡدِي سَفَرَةٖ ١٥","aya_text_emlaey":"بأيدي سفرة"},{"id":5774,"jozz":30,"page":585,"line_start":7,"line_end":7,"aya_no":16,"aya_text":"كِرَامِۭ بَرَرَةٖ ١٦","aya_text_emlaey":"كرام بررة"},{"id":5775,"jozz":30,"page":585,"line_start":7,"line_end":7,"aya_no":17,"aya_text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ ١٧","aya_text_emlaey":"قتل الإنسان ما أكفره"},{"id":5776,"jozz":30,"page":585,"line_start":7,"line_end":8,"aya_no":18,"aya_text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ ١٨","aya_text_emlaey":"من أي شيء خلقه"},{"id":5777,"jozz":30,"page":585,"line_start":8,"line_end":8,"aya_no":19,"aya_text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩","aya_text_emlaey":"من نطفة خلقه فقدره"},{"id":5778,"jozz":30,"page":585,"line_start":8,"line_end":8,"aya_no":20,"aya_text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ ٢٠","aya_text_emlaey":"ثم السبيل يسره"},{"id":5779,"jozz":30,"page":585,"line_start":9,"line_end":9,"aya_no":21,"aya_text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ ٢١","aya_text_emlaey":"ثم أماته فأقبره"},{"id":5780,"jozz":30,"page":585,"line_start":9,"line_end":9,"aya_no":22,"aya_text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ ٢٢","aya_text_emlaey":"ثم إذا شاء أنشره"},{"id":5781,"jozz":30,"page":585,"line_start":9,"line_end":9,"aya_no":23,"aya_text":"كـَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ ٢٣","aya_text_emlaey":"كلا لما يقض ما أمره"},{"id":5782,"jozz":30,"page":585,"line_start":10,"line_end":10,"aya_no":24,"aya_text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ ٢٤","aya_text_emlaey":"فلينظر الإنسان إلى طعامه"},{"id":5783,"jozz":30,"page":585,"line_start":10,"line_end":10,"aya_no":25,"aya_text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا ٢٥","aya_text_emlaey":"أنا صببنا الماء صبا"},{"id":5784,"jozz":30,"page":585,"line_start":10,"line_end":11,"aya_no