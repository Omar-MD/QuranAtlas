:"وما هو بقول شيطان رجيم"},{"id":5826,"jozz":30,"page":586,"line_start":14,"line_end":14,"aya_no":26,"aya_text":"فَأَيۡنَ تَذۡهَبُونَ ٢٦","aya_text_emlaey":"فأين تذهبون"},{"id":5827,"jozz":30,"page":586,"line_start":14,"line_end":14,"aya_no":27,"aya_text":"إِنۡ هُوَ إِلَّا ذِكۡرٞ لِّلۡعَٰلَمِينَ ٢٧","aya_text_emlaey":"إن هو إلا ذكر للعالمين"},{"id":5828,"jozz":30,"page":586,"line_start":14,"line_end":15,"aya_no":28,"aya_text":"لِمَن شَآءَ مِنكُمۡ أَن يَسۡتَقِيمَ ٢٨","aya_text_emlaey":"لمن شاء منكم أن يستقيم"},{"id":5829,"jozz":30,"page":586,"line_start":15,"line_end":15,"aya_no":29,"aya_text":"وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلۡعَٰلَمِينَ ٢٩","aya_text_emlaey":"وما تشاءون إلا أن يشاء الله رب العالمين"}]}