{"riwayah":"hafs","version":"18","sura_no":97,"sura_name_ar":"القَدر","sura_name_en":"Al-Qadr","ayat":[{"jozz":30,"page":598,"aya_no":1,"aya_text":"إِنَّآ أَنزَلۡنَٰهُ فِي لَيۡلَةِ ٱلۡقَدۡرِ","id":6126,"line_start":6,"line_end":6},{"jozz":30,"page":598,"aya_no":2,"aya_text":"وَمَآ أَدۡرَىٰكَ مَا لَيۡلَةُ ٱلۡقَدۡرِ","id":6127,"line_start":6,"line_end":6},{"jozz":30,"page":598,"aya_no":3,"aya_text":"لَيۡلَةُ ٱلۡقَدۡرِ خَيۡرٞ مِّنۡ أَلۡفِ شَهۡرٖ","id":6128,"line_start":7,"line_end":7},{"jozz":30,"page":598,"aya_no":4,"aya_text":"تَنَزَّلُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذۡنِ رَبِّهِم مِّن كُلِّ أَمۡرٖ","id":6129,"line_start":7,"line_end":8},{"jozz":30,"page":598,"aya_no":5,"aya_text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطۡلَعِ ٱلۡفَجۡرِ","id":6130,"line_start":8,"line_end":8}]}