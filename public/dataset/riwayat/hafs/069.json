{"riwayah":"hafs","version":"18","sura_no":69,"sura_name_ar":"الحَاقة","sura_name_en":"Al-Ḥāqqah","ayat":[{"jozz":29,"page":566,"aya_no":1,"aya_text":"ٱلۡحَآقَّةُ","id":5324,"line_start":12,"line_end":12},{"jozz":29,"page":566,"aya_no":2,"aya_text":"مَا ٱلۡحَآقَّةُ","id":5325,"line_start":12,"line_end":12},{"jozz":29,"page":566,"aya_no":3,"aya_text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ","id":5326,"line_start":12,"line_end":12},{"jozz":29,"page":566,"aya_no":4,"aya_text":"كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ","id":5327,"line_start":12,"line_end":13},{"jozz":29,"page":566,"aya_no":5,"aya_text":"فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ","id":5328,"line_start":13,"line_end":13},{"jozz":29,"page":566,"aya_no":6,"aya_text":"وَأَمَّا عَادٞ فَأُهۡلِكُواْ بِرِيحٖ صَرۡصَرٍ عَاتِيَةٖ","id":5329,"line_start":13,"line_end":14},{"jozz":29,"page":566,"aya_no":7,"aya_text":"سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومٗاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةٖ","id":5330,"line_start":14,"line_end":15},{"jozz":29,"page":566,"aya_no":8,"aya_text":"فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖ","id":5331,"line_start":15,"line_end":15},{"jozz":29,"page":567,"aya_no":9,"aya_text":"وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ","id":5332,"line_start":1,"line_end":1},{"jozz":29,"page":567,"aya_no":10,"aya_text":"فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةٗ رَّابِيَةً","id":5333,"line_start":1,"line_end":2},{"jozz":29,"page":567,"aya_no":11,"aya_text":"إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ","id":5334,"line_start":2,"line_end":3},{"jozz":29,"page":567,"aya_no":12,"aya_text":"لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةٗ وَتَعِيَهَآ أُذُنٞ وَٰعِيَةٞ","id":5335,"line_start":3,"line_end":3},{"jozz":29,"page":567,"aya_no":13,"aya_text":"فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةٞ وَٰحِدَةٞ","id":5336,"line_start":3,"line_end":4},{"jozz":29,"page":567,"aya_no":14,"aya_text":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ