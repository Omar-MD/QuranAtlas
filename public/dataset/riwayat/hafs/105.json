{"riwayah":"hafs","version":"18","sura_no":105,"sura_name_ar":"الفِيل","sura_name_en":"Al-Fīl","ayat":[{"id":6189,"jozz":30,"page":601,"line_start":13,"line_end":13,"aya_no":1,"aya_text":"أَلَمۡ تَرَ كَيۡفَ فَعَلَ رَبُّكَ بِأَصۡحَٰبِ ٱلۡفِيلِ ١","aya_text_emlaey":"ألم تر كيف فعل ربك بأصحاب الفيل"},{"id":6190,"jozz":30,"page":601,"line_start":13,"line_end":14,"aya_no":2,"aya_text":"أَلَمۡ يَجۡعَلۡ كَيۡدَهُمۡ فِي تَضۡلِيلٖ ٢","aya_text_emlaey":"ألم يجعل كيدهم في تضليل"},{"id":6191,"jozz":30,"page":601,"line_start":14,"line_end":14,"aya_no":3,"aya_text":"وَأَرۡسَلَ عَلَيۡهِمۡ طَيۡرًا أَبَابِيلَ ٣","aya_text_emlaey":"وأرسل عليهم طيرا أبابيل"},{"id":6192,"jozz":30,"page":601,"line_start":15,"line_end":15,"aya_no":4,"aya_text":"تَرۡمِيهِم بِحِجَارَةٖ مِّن سِجِّيلٖ ٤","aya_text_emlaey":"ترميهم بحجارة من سجيل"},{"id":6193,"jozz":30,"page":601,"line_start":15,"line_end":15,"aya_no":5,"aya_text":"فَجَعَلَهُمۡ كَعَصۡفٖ مَّأۡكُولِۭ ٥","aya_text_emlaey":"فجعلهم كعصف مأكول"}]}