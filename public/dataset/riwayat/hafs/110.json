{"riwayah":"hafs","version":"18","sura_no":110,"sura_name_ar":"النَّصر","sura_name_en":"An-Naṣr","ayat":[{"jozz":30,"page":603,"aya_no":1,"aya_text":"إِذَا جَآءَ نَصۡرُ ٱللَّهِ وَٱلۡفَتۡحُ","id":6214,"line_start":8,"line_end":8},{"jozz":30,"page":603,"aya_no":2,"aya_text":"وَرَأَيۡتَ ٱلنَّاسَ يَدۡخُلُونَ فِي دِينِ ٱللَّهِ أَفۡوَاجٗا","id":6215,"line_start":8,"line_end":9},{"jozz":30,"page":603,"aya_no":3,"aya_text":"فَسَبِّحۡ بِحَمۡدِ رَبِّكَ وَٱسۡتَغۡفِرۡهُۚ إِنَّهُۥ كَانَ تَوَّابَۢا","id":6216,"line_start":9,"line_end":10}]}