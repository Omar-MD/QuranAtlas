{"riwayah":"hafs","version":"18","sura_no":96,"sura_name_ar":"العَلَق","sura_name_en":"Al-‘Alaq","ayat":[{"id":6107,"jozz":30,"page":597,"line_start":11,"line_end":11,"aya_no":1,"aya_text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","aya_text_emlaey":"اقرأ باسم ربك الذي خلق"},{"id":6108,"jozz":30,"page":597,"line_start":11,"line_end":11,"aya_no":2,"aya_text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","aya_text_emlaey":"خلق الإنسان من علق"},{"id":6109,"jozz":30,"page":597,"line_start":11,"line_end":12,"aya_no":3,"aya_text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","aya_text_emlaey":"اقرأ وربك الأكرم"},{"id":6110,"jozz":30,"page":597,"line_start":12,"line_end":12,"aya_no":4,"aya_text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","aya_text_emlaey":"الذي علم بالقلم"},{"id":6111,"jozz":30,"page":597,"line_start":12,"line_end":13,"aya_no":5,"aya_text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","aya_text_emlaey":"علم الإنسان ما لم يعلم"},{"id":6112,"jozz":30,"page":597,"line_start":13,"line_end":13,"aya_no":6,"aya_text":"كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","aya_text_emlaey":"كلا إن الإنسان ليطغى"},{"id":6113,"jozz":30,"page":597,"line_start":13,"line_end":13,"aya_no":7,"aya_text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","aya_text_emlaey":"أن رآه استغنى"},{"id":6114,"jozz":30,"page":597,"line_start":14,"line_end":14,"aya_no":8,"aya_text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","aya_text_emlaey":"إن إلى ربك الرجعى"},{"id":6115,"jozz":30,"page":597,"line_start":14,"line_end":14,"aya_no":9,"aya_text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","aya_text_emlaey":"أرأيت الذي ينهى"},{"id":6116,"jozz":30,"page":597,"line_start":14,"line_end":15,"aya_no":10,"aya_text":"عَبۡدًا إِذَا صَلَّىٰٓ","aya_text_emlaey":"عبدا إذا صلى"},{"id":6117,"jozz":30,"page":597,"line_start":15,"line_end":15,"aya_no":11,"aya_text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","aya_text_emlaey":"أرأيت إن كان على الهدى"},{"id":6118,"jozz":30,"page":597,"line_start":15,"line_end":15,"aya_no":12,"aya_text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","aya_text_emlaey":"أو أمر بالتقوى"},{"id":611