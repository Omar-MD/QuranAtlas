{"riwayah":"hafs","version":"18","sura_no":86,"sura_name_ar":"الطَّارق","sura_name_en":"Aṭ-Ṭāriq","ayat":[{"id":5932,"jozz":30,"page":591,"line_start":3,"line_end":3,"aya_no":1,"aya_text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ ١","aya_text_emlaey":"والسماء والطارق"},{"id":5933,"jozz":30,"page":591,"line_start":3,"line_end":3,"aya_no":2,"aya_text":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ ٢","aya_text_emlaey":"وما أدراك ما الطارق"},{"id":5934,"jozz":30,"page":591,"line_start":3,"line_end":3,"aya_no":3,"aya_text":"ٱلنَّجۡمُ ٱلثَّاقِبُ ٣","aya_text_emlaey":"النجم الثاقب"},{"id":5935,"jozz":30,"page":591,"line_start":4,"line_end":4,"aya_no":4,"aya_text":"إِن كُلُّ نَفۡسٖ لَّمَّا عَلَيۡهَا حَافِظٞ ٤","aya_text_emlaey":"إن كل نفس لما عليها حافظ"},{"id":5936,"jozz":30,"page":591,"line_start":4,"line_end":4,"aya_no":5,"aya_text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ ٥","aya_text_emlaey":"فلينظر الإنسان مم خلق"},{"id":5937,"jozz":30,"page":591,"line_start":5,"line_end":5,"aya_no":6,"aya_text":"خُلِقَ مِن مَّآءٖ دَافِقٖ ٦","aya_text_emlaey":"خلق من ماء دافق"},{"id":5938,"jozz":30,"page":591,"line_start":5,"line_end":5,"aya_no":7,"aya_text":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ ٧","aya_text_emlaey":"يخرج من بين الصلب والترائب"},{"id":5939,"jozz":30,"page":591,"line_start":5,"line_end":6,"aya_no":8,"aya_text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرٞ ٨","aya_text_emlaey":"إنه على رجعه لقادر"},{"id":5940,"jozz":30,"page":591,"line_start":6,"line_end":6,"aya_no":9,"aya_text":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ ٩","aya_text_emlaey":"يوم تبلى السرائر"},{"id":5941,"jozz":30,"page":591,"line_start":6,"line_end":7,"aya_no":10,"aya_text":"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖ ١٠","aya_text_emlaey":"فما له من قوة ولا ناصر"},{"id":5942,"jozz":30,"page":591,"line_start":7,"line_end":7,"aya_no":11,"aya_text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ ١١","aya_text_emlaey":"والسماء ذات الرجع"},{"id":5943,"jozz":30,"page":591,"line_start":7,"line_end":7,"aya_no":12,"aya_text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ ١٢","aya_text_eml