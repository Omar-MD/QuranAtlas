{"riwayah":"warsh","version":"10","sura_no":26,"sura_name_ar":"الشعراء","sura_name_en":"Ash-Shu‘arā’","ayat":[{"id":2928,"jozz":19,"page":"367","line_start":3,"line_end":3,"aya_no":1,"aya_text":"طَسِٓمِّٓۖ تِلْكَ ءَايَٰتُ اُ۬لْكِتَٰبِ اِ۬لْمُبِينِۖ"},{"id":2929,"jozz":19,"page":"367","line_start":3,"line_end":4,"aya_no":2,"aya_text":"لَعَلَّكَ بَٰخِعٞ نَّفْسَكَ أَلَّا يَكُونُواْ مُومِنِينَۖ"},{"id":2930,"jozz":19,"page":"367","line_start":4,"line_end":5,"aya_no":3,"aya_text":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ اَ۬لسَّمَآءِ اَ۟يَةٗ فَظَلَّتَ اَعْنَٰقُهُمْ لَهَا خَٰضِعِينَۖ"},{"id":2931,"jozz":19,"page":"367","line_start":5,"line_end":6,"aya_no":4,"aya_text":"وَمَا يَاتِيهِم مِّن ذِكْرٖ مِّنَ اَ۬لرَّحْمَٰنِ مُحْدَثٍ اِلَّا كَانُواْ عَنْهُ مُعْرِضِينَۖ"},{"id":2932,"jozz":19,"page":"367","line_start":6,"line_end":7,"aya_no":5,"aya_text":"فَقَدْ كَذَّبُواْ فَسَيَاتِيهِمُۥٓ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ"},{"id":2933,"jozz":19,"page":"367","line_start":7,"line_end":8,"aya_no":6,"aya_text":"أَوَلَمْ يَرَوِاْ اِلَى اَ۬لَارْضِ كَمَ اَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٖ كَرِيمٍۖ"},{"id":2934,"jozz":19,"page":"367","line_start":8,"line_end":8,"aya_no":7,"aya_text":"اِنَّ فِے ذَٰلِكَ لَأٓيَةٗۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ"},{"id":2935,"jozz":19,"page":"367","line_start":8,"line_end":9,"aya_no":8,"aya_text":"وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ"},{"id":2936,"jozz":19,"page":"367","line_start":9,"line_end":9,"aya_no":9,"aya_text":"وَإِذْ نَاد۪ىٰ رَبُّكَ مُوس۪ىٰٓ أَنِ اِ۪يتِ اِ۬لْقَوْمَ اَ۬لظَّٰلِمِينَ"},{"id":2937,"jozz":19,"page":"367","line_start":10,"line_end":10,"aya_no":10,"aya_text":" قَوْمَ فِرْعَوْنَۖ أَلَا يَتَّقُونَۖ"},{"id":2938,"jozz":19,"page":"367","line_start":10,"line_end":10,"aya_no":11,"aya_text":"قَالَ رَبِّ إِنِّيَ أَخَافُ أَنْ يُّكَذِّبُونِ"},{"id":2939,"jozz":19,"page":"367","line_start":10,"line_end":11,"aya_no":12,"aya_text":"وَيَضِيقُ صَدْرِے وَلَا يَنطَلِقُ لِسَانِے فَأَرْسِلِ اِلَىٰ هَٰرُونَ"},{"id":2940,"jozz":19,"page":"367","line_start":11,"line_end":12,"aya_no":13,"aya_text":"وَلَهُمْ عَلَيَّ ذَنۢبٞ فَأَخَافُ أَنْ يَّقْتُلُونِۖ"},{"id":2941,"jozz":19,"page":"367","line_start":12,"line_end":12,"aya_no":14,"aya_text":"قَالَ كَلَّاۖ فَاذْهَبَا بِـَٔايَٰتِنَآ إِنَّا مَعَكُم مُّسْتَمِعُونَۖ"},{"id":2942,"jozz":19,"page":"367","line_start":13,"line_end":13,"aya_no":15,"aya_text":" فَاتِيَا فِرْعَوْنَ فَقُولَآ إِنَّا رَسُولُ رَبِّ اِ۬لْعَٰلَمِينَ"},{"id":2943,"jozz":19,"page":"367","line_start":13,"line_end":14,"aya_no":16,"aya_text":"أَنَ اَرْسِلْ مَعَنَا بَنِےٓ إِسْرَآءِيلَۖ"},{"id":2944,"jozz":19,"page":"367","line_start":14,"line_end":15,"aya_no":17,"aya_text":"قَالَ أَلَمْ نُرَبِّكَ فِينَا وَلِيداٗ وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ"},{"id":2945,"jozz":19,"page":"367","line_start":15,"line_end":15,"aya_no":18,"aya_text":"وَفَعَلْتَ فَعْلَتَكَ اَ۬لتِے فَعَلْتَ وَأَنتَ مِنَ اَ۬لْكٰ۪فِرِينَۖ"},{"id":2946,"jozz":19,"page":"368","line_start":1,"line_end":1,"aya_no":19,"aya_text":" قَالَ فَعَلْتُهَآ إِذاٗ وَأَنَا مِنَ اَ۬لضَّآلِّينَۖ"},{"id":2947,"jozz":19,"page":"368","line_start":1,"line_end":2,"aya_no":20,"aya_text":"فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِے رَبِّے حُكْماٗ وَجَعَلَنِے مِنَ اَ۬لْمُرْسَلِينَۖ"},{"id":2948,"jozz":19,"page":"368","line_start":2,"line_end":3,"aya_no":21,"aya_text":"وَتِلْكَ نِعْمَةٞ تَمُنُّهَا عَلَيَّ أَنْ عَبَّدتَّ بَنِےٓ إِسْرَآءِيلَۖ"},{"id":2949,"jozz":19,"page":"368","line_start":3,"line_end":3,"aya_no":22,"aya_text":"قَالَ فِرْعَوْنُ وَمَا رَبُّ اُ۬لْعَٰلَمِينَۖ"},{"id":2950,"jozz":19,"page":"368","line_start":4,"line_end":4,"aya_no":23,"aya_text":" قَالَ رَبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَآ إِن كُنتُم مُّوقِنِينَۖ"},{"id":2951,"jozz":19,"page":"368","line_start":5,"line_end":5,"aya_no":24,"aya_text":" ۞ قَالَ لِمَنْ حَوْلَهُۥٓ أَلَا تَسْتَمِعُونَۖ"},{"id":2952,"jozz":19,"page":"368","line_start":5,"line_end":6,"aya_no":25,"aya_text":"قَالَ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ اُ۬لَاوَّلِينَۖ"},{"id":2953,"jozz":19,"page":"368","line_start":6,"line_end":6,"aya_no":26,"aya_text":"قَالَ إِنَّ رَسُولَكُمُ اُ۬لذِےٓ أُرْسِلَ إِلَيْكُمْ لَمَجْنُونٞۖ"},{"id":2954,"jozz":19,"page":"368","line_start":7,"line_end":7,"aya_no":27,"aya_text":" قَالَ رَبُّ اُ۬لْمَشْرِقِ وَالْمَغْرِبِ وَمَا بَيْنَهُمَآ إِن كُنتُمْ تَعْقِلُونَۖ"},{"id":2955,"jozz":19,"page":"368","line_start":8,"line_end":8,"aya_no":28,"aya_text":" قَالَ لَئِنِ اِ۪تَّخَذتَّ إِلَٰهاً غَيْرِے لَأَجْعَلَنَّكَ مِنَ اَ۬لْمَسْجُونِينَۖ"},{"id":2956,"jozz":19,"page":"368","line_start":9,"line_end":9,"aya_no":29,"aya_text":" قَالَ أَوَلَوْ جِئْتُكَ بِشَےْءٖ مُّبِينٖۖ"},{"id":2957,"jozz":19,"page":"368","line_start":9,"line_end":10,"aya_no":30,"aya_text":"قَالَ فَاتِ بِهِۦٓ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ"},{"id":2958,"jozz":19,"page":"368","line_start":10,"line_end":10,"aya_no":31,"aya_text":"فَأَلْق۪ىٰ عَصَاهُ فَإِذَا هِيَ ثُعْبَانٞ مُّبِينٞ"},{"id":2959,"jozz":19,"page":"368","line_start":11,"line_end":11,"aya_no":32,"aya_text":" وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيْضَآءُ لِلنَّٰظِرِينَۖ"},{"id":2960,"jozz":19,"page":"368","line_start":11,"line_end":12,"aya_no":33,"aya_text":"قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمٞ"},{"id":2961,"jozz":19,"page":"368","line_start":12,"line_end":13,"aya_no":34,"aya_text":"يُرِيدُ أَنْ يُّخْرِجَكُم مِّنَ اَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَامُرُونَۖ"},{"id":2962,"jozz":19,"page":"368","line_start":13,"line_end":14,"aya_no":35,"aya_text":"قَالُوٓاْ أَرْجِهِۦ وَأَخَاهُ وَابْعَثْ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَ"},{"id":2963,"jozz":19,"page":"368","line_start":14,"line_end":14,"aya_no":36,"aya_text":"يَاتُوكَ بِكُلِّ سَحّ۪ارٍ عَلِيمٖۖ"},{"id":2964,"jozz":19,"page":"368","line_start":14,"line_end":15,"aya_no":37,"aya_text":"فَجُمِعَ اَ۬لسَّحَرَةُ لِمِيقَٰتِ يَوْمٖ مَّعْلُومٖۖ"},{"id":2965,"jozz":19,"page":"368","line_start":15,"line_end":15,"aya_no":38,"aya_text":"وَقِيلَ لِلنَّاسِ هَلَ اَنتُم مُّجْتَمِعُونَ"},{"id":2966,"jozz":19,"page":"369","line_start":1,"line_end":1,"aya_no":39,"aya_text":" لَعَلَّنَا نَتَّبِعُ اُ۬لسَّحَرَةَ إِن كَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ"},{"id":2967,"jozz":19,"page":"369","line_start":1,"line_end":2,"aya_no":40,"aya_text":"فَلَمَّا جَآءَ اَ۬لسَّحَرَةُ قَالُواْ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْراً اِن كُنَّا نَحْنُ اُ۬لْغَٰلِبِينَۖ"},{"id":2968,"jozz":19,"page":"369","line_start":2,"line_end":3,"aya_no":41,"aya_text":"قَالَ نَعَمْ وَإِنَّكُمُۥٓ إِذاٗ لَّمِنَ اَ۬لْمُقَرَّبِينَۖ"},{"id":2969,"jozz":19,"page":"369","line_start":3,"line_end":4,"aya_no":42,"aya_text":"قَالَ لَهُم مُّوس۪ىٰٓ أَلْقُواْ مَآ أَنتُم مُّلْقُونَۖ"},{"id":2970,"jozz":19,"page":"369","line_start":4,"line_end":5,"aya_no":43,"aya_text":"فَأَلْقَوْاْ حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُواْ بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ اُ۬لْغَٰلِبُونَۖ"},{"id":2971,"jozz":19,"page":"369","line_start":5,"line_end":5,"aya_no":44,"aya_text":"فَأَلْق۪ىٰ مُوس۪ىٰ عَصَاهُ فَإِذَا هِيَ تَلَقَّفُ مَا يَافِكُونَۖ"},{"id":2972,"jozz":19,"page":"369","line_start":6,"line_end":6,"aya_no":45,"aya_text":" فَأُلْقِيَ اَ۬لسَّحَرَةُ سَٰجِدِينَۖ"},{"id":2973,"jozz":19,"page":"369","line_start":6,"line_end":6,"aya_no":46,"aya_text":"قَالُوٓاْ ءَامَنَّا بِرَبِّ اِ۬لْعَٰلَمِينَۖ"},{"id":2974,"jozz":19,"page":"369","line_start":6,"line_end":7,"aya_no":47,"aya_text":"رَبِّ مُوس۪ىٰ وَهَٰرُونَۖ"},{"id":2975,"jozz":19,"page":"369","line_start":7,"line_end":8,"aya_no":48,"aya_text":"قَالَ ءَاٰ۬مَنتُمْ لَهُۥ قَبْلَ أَنَ اٰذَنَ لَكُمُۥٓ إِنَّهُۥ لَكَبِيرُكُمُ اُ۬لذِے عَلَّمَكُمُ اُ۬لسِّحْرَۖ فَلَسَوْفَ تَعْلَمُونَۖ"},{"id":2976,"jozz":19,"page":"369","line_start":8,"line_end":9,"aya_no":49,"aya_text":"لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفٖ وَلَأُصَلِّبَنَّكُمُۥٓ أَجْمَعِينَۖ"},{"id":2977,"jozz":19,"page":"369","line_start":9,"line_end":10,"aya_no":50,"aya_text":"۞ قَالُواْ لَا ضَيْرَۖ إِنَّآ إِلَىٰ رَبِّنَا مُنقَلِبُونَۖ"},{"id":2978,"jozz":19,"page":"369","line_start":10,"line_end":11,"aya_no":51,"aya_text":"إِنَّا نَطْمَعُ أَنْ يَّغْفِرَ لَنَا رَبُّنَا خَطَٰيٰ۪نَآ أَن كُنَّآ أَوَّلَ اَ۬لْمُومِنِينَۖ"},{"id":2979,"jozz":19,"page":"369","line_start":11,"line_end":12,"aya_no":52,"aya_text":"وَأَوْحَيْنَآ إِلَىٰ مُوس۪ىٰٓ أَنِ اِ۪سْرِ بِعِبَادِيَ إِنَّكُم مُّتَّبَعُونَۖ"},{"id":2980,"jozz":19,"page":"369","line_start":12,"line_end":12,"aya_no":53,"aya_text":"فَأَرْسَلَ فِرْعَوْنُ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَۖ"},{"id":2981,"jozz":19,"page":"369","line_start":12,"line_end":13,"aya_no":54,"aya_text":"إِنَّ هَٰٓؤُلَآءِ لَشِرْذِمَةٞ قَلِيلُونَ"},{"id":2982,"jozz":19,"page":"369","line_start":13,"line_end":13,"aya_no":55,"aya_text":"وَإِنَّهُمْ لَنَا لَغَآئِظُونَ"},{"id":2983,"jozz":19,"page":"369","line_start":13,"line_end":13,"aya_no":56,"aya_text":"وَإِنَّا لَجَمِيعٌ حَذِرُونَۖ"},{"id":2984,"jozz":19,"page":"369","line_start":14,"line_end":14,"aya_no":57,"aya_text":" فَأَخْرَجْنَٰهُم مِّن جَنَّٰتٖ وَعُيُونٖ"},{"id":2985,"jozz":19,"page":"369","line_start":14,"line_end":14,"aya_no":58,"aya_text":"وَكُنُوزٖ وَمَقَامٖ كَرِيمٖۖ"},{"id":2986,"jozz":19,"page":"369","line_start":15,"line_end":15,"aya_no":59,"aya_text":" كَذَٰلِكَۖ وَأَوْرَثْنَٰهَا بَنِےٓ إِسْرَآءِيلَ"},{"id":2987,"jozz":19,"page":"369","line_start":15,"line_end":15,"aya_no":60,"aya_text":"فَأَتْبَعُوهُم مُّشْرِقِينَۖ"},{"id":2988,"jozz":19,"page":"370","line_start":1,"line_end":1,"aya_no":61,"aya_text":" فَلَمَّا تَرَٰٓءَا اَ۬لْجَمْعَٰنِ قَالَ أَصْحَٰبُ مُوس۪ىٰٓ إِنَّا لَمُدْرَكُونَۖ"},{"id":2989,"jozz":19,"page":"370","line_start":1,"line_end":2,"aya_no":62,"aya_text":"قَالَ كَلَّآۖ إِنَّ مَعِے رَبِّے سَيَهْدِينِۖ"},{"id":2990,"jozz":19,"page":"370","line_start":2,"line_end":3,"aya_no":63,"aya_text":"فَأَوْحَيْنَآ إِلَىٰ مُوس۪ىٰٓ أَنِ اِ۪ضْرِب بِّعَصَاكَ اَ۬لْبَحْرَ فَانفَلَقَ فَكَانَ كُلُّ فِرْقٖ كَالطَّوْدِ اِ۬لْعَظِيمِۖ"},{"id":2991,"jozz":19,"page":"370","line_start":4,"line_end":4,"aya_no":64,"aya_text":" وَأَزْلَفْنَا ثَمَّ اَ۬لَاخَرِينَۖ"},{"id":2992,"jozz":19,"page":"370","line_start":4,"line_end":4,"aya_no":65,"aya_text":"وَأَنجَيْنَا مُوس۪ىٰ وَمَن مَّعَهُۥٓ أَجْمَ