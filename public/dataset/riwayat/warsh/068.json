{"riwayah":"warsh","version":"10","sura_no":68,"sura_name_ar":"القَلَم","sura_name_en":"Al-Qalam","ayat":[{"id":5250,"jozz":29,"page":"564","line_start":8,"line_end":8,"aya_no":1,"aya_text":"نُّٓۖ وَالْقَلَمِ وَمَا يَسْطُرُونَ ١"},{"id":5251,"jozz":29,"page":"564","line_start":8,"line_end":8,"aya_no":2,"aya_text":"مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٖ ٢"},{"id":5252,"jozz":29,"page":"564","line_start":9,"line_end":9,"aya_no":3,"aya_text":" وَإِنَّ لَكَ لَأَجْراً غَيْرَ مَمْنُونٖ ٣"},{"id":5253,"jozz":29,"page":"564","line_start":9,"line_end":9,"aya_no":4,"aya_text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٖۖ ٤"},{"id":5254,"jozz":29,"page":"564","line_start":10,"line_end":10,"aya_no":5,"aya_text":" فَسَتُبْصِرُ وَيُبْصِرُونَ ٥"},{"id":5255,"jozz":29,"page":"564","line_start":10,"line_end":10,"aya_no":6,"aya_text":"بِأَييِّكُمُ اُ۬لْمَفْتُونُۖ ٦"},{"id":5256,"jozz":29,"page":"564","line_start":10,"line_end":11,"aya_no":7,"aya_text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَۖ ٧"},{"id":5257,"jozz":29,"page":"564","line_start":11,"line_end":12,"aya_no":8,"aya_text":"فَلَا تُطِعِ اِ۬لْمُكَذِّبِينَۖ ٨"},{"id":5258,"jozz":29,"page":"564","line_start":12,"line_end":12,"aya_no":9,"aya_text":"وَدُّواْ لَوْ تُدْهِنُ فَيُدْهِنُونَۖ ٩"},{"id":5259,"jozz":29,"page":"564","line_start":12,"line_end":13,"aya_no":10,"aya_text":"وَلَا تُطِعْ كُلَّ حَلَّٰفٖ مَّهِينٍ ١٠"},{"id":5260,"jozz":29,"page":"564","line_start":13,"line_end":13,"aya_no":11,"aya_text":"هَمَّازٖ مَّشَّآءِۢ بِنَمِيمٖ ١١"},{"id":5261,"jozz":29,"page":"564","line_start":13,"line_end":13,"aya_no":12,"aya_text":"مَّنَّاعٖ لِّلْخَيْرِ مُعْتَدٍ اَثِيمٍ ١٢"},{"id":5262,"jozz":29,"page":"564","line_start":14,"line_end":14,"aya_no":13,"aya_text":" عُتُلِّۢ بَعْدَ ذَٰلِكَ زَنِيمٍ ١٣"},{"id":5263,"jozz":29,"page":"564","line_start":14,"line_end":14,"aya_no":14,"aya_text":"اَن كَانَ ذَا مَالٖ وَبَنِينَ ١٤"},{"id":5264,"jozz":29,"page":"564","line_start":14,"line_end":15,"aya_no":15,"aya_text":"إِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ ١٥"},{"id":5265,"jozz":29,"page":"564","line_start":15,"line_end":15,"aya_no":16,"aya_text":"سَنَسِمُهُۥ عَلَى اَ۬لْخُرْطُومِۖ ١٦"},{"id":5266,"jozz":29,"page":"565","line_start":1,"line_end":1,"aya_no":17,"aya_text":" إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ اَ۬لْجَنَّةِ إِذَ اَقْسَمُواْ لَيَصْرِمُنَّهَا مُصْبِحِينَ ١٧"},{"id":5267,"jozz":29,"page":"565","line_start":1,"line_end":2,"aya_no":18,"aya_text":"وَلَا يَسْتَثْنُونَۖ ١٨"},{"id":5268,"jozz":29,"page":"565","line_start":2,"line_end":2,"aya_no":19,"aya_text":"۞ فَطَافَ عَلَيْهَا طَآئِفٞ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ ١٩"},{"id":5269,"jozz":29,"page":"565","line_start":2,"line_end":3,"aya_no":20,"aya_text":"فَأَصْبَحَتْ كَالصَّرِيمِۖ ٢٠"},{"id":5270,"jozz":29,"page":"565","line_start":3,"line_end":3,"aya_no":21,"aya_text":"فَتَنَادَوْاْ مُصْبِحِينَ ٢١"},{"id":5271,"jozz":29,"page":"565","line_start":3,"line_end":4,"aya_no":22,"aya_text":"أَنُ اُ۟غْدُواْ عَلَىٰ حَرْثِكُمُۥٓ إِن كُنتُمْ صَٰرِمِينَۖ ٢٢"},{"id":5272,"jozz":29,"page":"565","line_start":4,"line_end":4,"aya_no":23,"aya_text":"فَانطَلَقُواْ وَهُمْ يَتَخَٰفَتُونَ ٢٣"},{"id":5273,"jozz":29,"page":"565","line_start":4,"line_end":5,"aya_no":24,"aya_text":"أَن لَّا يَدْخُلَنَّهَا اَ۬لْيَوْمَ عَلَيْكُم مِّسْكِينٞۖ ٢٤"},{"id":5274,"jozz":29,"page":"565","line_start":5,"line_end":5,"aya_no":25,"aya_text":"وَغَدَوْاْ عَلَىٰ حَرْدٖ قَٰدِرِينَۖ ٢٥"},{"id":5275,"jozz":29,"page":"565","line_start":5,"line_end":6,"aya_no":26,"aya_text":"فَلَمَّا رَأَوْهَا قَالُوٓاْ إِنَّا لَضَآلُّونَ ٢٦"},{"id":5276,"jozz":29,"page":"565","line_start":6,"line_end":6,"aya_no":27,"aya_text":"بَلْ نَحْنُ مَحْرُومُونَۖ ٢٧"},{"id":5277,"jozz":29,"page":"565","line_start":6,"line_end":7,"aya_no":28,"aya_text":"قَالَ أَوْسَطُهُمُۥٓ أَلَمَ اَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَۖ ٢٨"},{"id":5278,"jozz":29,"page":"565","line_start":7,"line_end":7,"aya_no":29,"aya_text":"قَالُواْ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَۖ ٢٩"},{"id":5279,"jozz":29,"page":"565","line_start":7,"line_end":8,"aya_no":30,"aya_text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٖ يَتَلَٰوَمُونَۖ ٣٠"},{"id":5280,"jozz":29,"page":"565","line_start":8,"line_end":8,"aya_no":31,"aya_text":"قَالُواْ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ ٣١"},{"id":5281,"jozz":29,"page":"565","line_start":8,"line_end":9,"aya_no":32,"aya_text":"عَس۪ىٰ رَبُّنَآ أَنْ يُّبَدِّلَنَا خَيْراٗ مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَۖ ٣٢"},{"id":5282,"jozz":29,"page":"565","line_start":9,"line_end":10,"aya_no":33,"aya_text":"كَذَٰلِكَ اَ۬لْعَذَابُۖ وَلَعَذَابُ اُ۬لَاخِرَةِ أَكْبَرُ لَوْ كَانُواْ يَعْلَمُونَۖ ٣٣"},{"id":5283,"jozz":29,"page":"565","line_start":10,"line_end":10,"aya_no":34,"aya_text":"إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ اِ۬لنَّعِيمِۖ ٣٤"},{"id":5284,"jozz":29,"page":"565","line_start":11,"line_end":11,"aya_no":35,"aya_text":" أَفَنَجْعَلُ اُ۬لْمُسْلِمِينَ كَالْمُجْرِمِينَۖ ٣٥"},{"id":5285,"jozz":29,"page":"565","line_start":11,"line_end":11,"aya_no":36,"aya_text":"مَا لَكُمْۖ كَيْفَ تَحْكُمُونَۖ ٣٦"},{"id":5286,"jozz":29,"page":"565","line_start":11,"line_end":12,"aya_no":37,"aya_text":"أَمْ لَكُمْ كِتَٰبٞ فِيهِ تَدْرُسُونَ ٣٧"},{"id":5287,"jozz":29,"page":"565","line_start":12,"line_end":12,"aya_no":38,"aya_text":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَۖ ٣٨"},{"id":5288,"jozz":29,"page":"565","line_start":12,"line_end":13,"aya_no":39,"aya_text":"أَمْ لَكُمُۥٓ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ اِلَىٰ يَوْمِ اِ۬لْقِيَٰمَةِ إِنَّ لَكُمْ لَمَا تَحْكُمُونَۖ ٣٩"},{"id":5289,"jozz":29,"page":"565","line_start":13,"line_end":14,"aya_no":40,"aya_text":"سَلْهُمُۥٓ أَيُّهُم بِذَٰلِكَ زَعِيمٌۖ ٤٠"},{"id":5290,"jozz":29,"page":"565","line_start":14,"line_end":14,"aya_no":41,"aya_text":"اَمْ لَهُمْ شُرَكَآءُ فَلْيَاتُواْ بِشُرَكَآئِهِمُۥٓ إِن كَانُواْ صَٰدِقِينَۖ ٤١"},{"id":5291,"jozz":29,"page":"565","line_start":15,"line_end":15,"aya_no":42,"aya_text":" يَوْمَ يُكْشَفُ عَن سَاقٖ وَيُدْعَوْنَ إِلَى اَ۬لسُّجُودِ فَلَا يَسْتَطِيعُونَۖ ٤٢"},{"id":5292,"jozz":29,"page":"566","line_start":1,"line_end":2,"aya_no":43,"aya_text":" خَٰشِعَةً اَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ وَقَدْ كَانُواْ يُدْعَوْنَ إِلَى اَ۬لسُّجُودِ وَهُمْ سَٰلِمُونَۖ ٤٣"},{"id":5293,"jozz":29,"page":"566","line_start":2,"line_end":3,"aya_no":44,"aya_text":"فَذَرْنِے وَمَنْ يُّكَذِّبُ بِهَٰذَا اَ۬لْحَدِيثِۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ ٤٤"},{"id":5294,"jozz":29,"page":"566","line_start":3,"line_end":3,"aya_no":45,"aya_text":"وَأُمْلِے لَهُمُۥٓۖ إِنَّ كَيْدِے مَتِينٌۖ ٤٥"},{"id":5295,"jozz":29,"page":"566","line_start":3,"line_end":4,"aya_no":46,"aya_text":"اَمْ تَسْـَٔلُهُمُۥٓ أَجْراٗ فَهُم مِّن مَّغْرَمٖ مُّثْقَلُونَۖ ٤٦"},{"id":5296,"jozz":29,"page":"566","line_start":4,"line_end":4,"aya_no":47,"aya_text":"أَمْ عِندَهُمُ اُ۬لْغَيْبُ فَهُمْ يَكْتُبُونَۖ ٤٧"},{"id":5297,"jozz":29,"page":"566","line_start":5,"line_end":6,"aya_no":48,"aya_text":" ۞ فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَٰحِبِ اِ۬لْحُوتِ إِذْ نَاد۪ىٰ وَهُوَ مَكْظُومٞۖ ٤٨"},{"id":5298,"jozz":29,"page":"566","line_start":6,"line_end":7,"aya_no":49,"aya_text":"لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٞ مِّن رَّبِّهِۦ لَنُبِذَ بِالْعَرَآءِ وَهُوَ مَذْمُومٞۖ ٤٩"},{"id":5299,"jozz":29,"page":"566","line_start":7,"line_end":7,"aya_no":50,"aya_text":"فَاجْتَبٰ۪هُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ اَ۬لصَّٰلِحِينَۖ ٥٠"},{"id":5300,"jozz":29,"page":"566","line_start":8,"line_end":9,"aya_no":51,"aya_text":" وَإِنْ يَّكَادُ اُ۬لذِينَ كَفَرُواْ لَيَزْلِقُونَكَ بِأَبْصٰ۪رِهِمْ لَمَّا سَمِعُواْ اُ۬لذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٞۖ ٥١"},{"id":5301,"jozz":29,"page":"566","line_start":9,"line_end":9,"aya_no":52,"aya_text":"وَمَا هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَۖ ٥٢"}]}