{"riwayah":"warsh","version":"10","sura_no":69,"sura_name_ar":"الحَاقة","sura_name_en":"Al-Ḥāqqah","ayat":[{"id":5302,"jozz":29,"page":"566","line_start":12,"line_end":12,"aya_no":1,"aya_text":"اَ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ ١"},{"id":5303,"jozz":29,"page":"566","line_start":12,"line_end":12,"aya_no":2,"aya_text":"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْحَآقَّةُۖ ٢"},{"id":5304,"jozz":29,"page":"566","line_start":12,"line_end":13,"aya_no":3,"aya_text":"كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ ٣"},{"id":5305,"jozz":29,"page":"566","line_start":13,"line_end":13,"aya_no":4,"aya_text":"فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ ٤"},{"id":5306,"jozz":29,"page":"566","line_start":13,"line_end":14,"aya_no":5,"aya_text":"وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ ٥"},{"id":5307,"jozz":29,"page":"566","line_start":14,"line_end":15,"aya_no":6,"aya_text":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْع۪ىٰ كَأَنَّهُمُۥٓ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ ٦"},{"id":5308,"jozz":29,"page":"566","line_start":15,"line_end":15,"aya_no":7,"aya_text":"فَهَلْ تَر۪ىٰ لَهُم مِّنۢ بَاقِيَةٖۖ ٧"},{"id":5309,"jozz":29,"page":"567","line_start":1,"line_end":1,"aya_no":8,"aya_text":" وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُوتَفِكَٰتُ بِالْخَاطِئَةِ ٨"},{"id":5310,"jozz":29,"page":"567","line_start":1,"line_end":2,"aya_no":9,"aya_text":"فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمُۥٓ أَخْذَةٗ رَّابِيَةًۖ ٩"},{"id":5311,"jozz":29,"page":"567","line_start":2,"line_end":3,"aya_no":10,"aya_text":"اِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ ١٠"},{"id":5312,"jozz":29,"page":"567","line_start":3,"line_end":3,"aya_no":11,"aya_text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَآ أُذْنٞ وَٰعِيَةٞۖ ١١"},{"id":5313,"jozz":29,"page":"567","line_start":3,"line_end":4,"aya_no":12,"aya_text":"فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ ١٢"},{"id":5314,"jozz":29,"page":"567","line_start":4,"line_end":5,"aya_no":13,"aya_text":"وَ