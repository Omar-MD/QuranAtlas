{"riwayah":"warsh","version":"10","sura_no":95,"sura_name_ar":"التِّين","sura_name_en":"At-Tīn","ayat":[{"jozz":30,"page":"597","aya_no":1,"aya_text":"وَالتِّينِ وَالزَّيْتُونِ"},{"jozz":30,"page":"597","aya_no":2,"aya_text":"وَطُورِ سِينِينَ"},{"jozz":30,"page":"597","aya_no":3,"aya_text":"وَهَٰذَا اَ۬لْبَلَدِ اِ۬لَامِينِ"},{"jozz":30,"page":"597","aya_no":4,"aya_text":"لَقَدْ خَلَقْنَا اَ۬لِانسَٰنَ فِےٓ أَحْسَنِ تَقْوِيمٖ"},{"jozz":30,"page":"597","aya_no":5,"aya_text":"ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ"},{"jozz":30,"page":"597","aya_no":6,"aya_text":" إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونٖۖ"},{"jozz":30,"page":"597","aya_no":7,"aya_text":" فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ"},{"jozz":30,"page":"597","aya_no":8,"aya_text":"أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ"}]}