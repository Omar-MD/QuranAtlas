{"riwayah":"warsh","version":"10","sura_no":83,"sura_name_ar":"المُطَففين","sura_name_en":"Al-Muṭaffifīn","ayat":[{"id":5824,"jozz":30,"page":"587","line_start":14,"line_end":14,"aya_no":1,"aya_text":"وَيْلٞ لِّلْمُطَفِّفِينَ"},{"id":5825,"jozz":30,"page":"587","line_start":14,"line_end":14,"aya_no":2,"aya_text":"اَ۬لذِينَ إِذَا اَ۪كْتَالُواْ عَلَى اَ۬لنَّاسِ يَسْتَوْفُونَ"},{"id":5826,"jozz":30,"page":"587","line_start":14,"line_end":15,"aya_no":3,"aya_text":"وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ"},{"id":5827,"jozz":30,"page":"587","line_start":15,"line_end":15,"aya_no":4,"aya_text":"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"},{"id":5828,"jozz":30,"page":"588","line_start":1,"line_end":1,"aya_no":5,"aya_text":" لِيَوْمٍ عَظِيمٖ"},{"id":5829,"jozz":30,"page":"588","line_start":1,"line_end":1,"aya_no":6,"aya_text":"يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ"},{"id":5830,"jozz":30,"page":"588","line_start":1,"line_end":2,"aya_no":7,"aya_text":"كَلَّآ إِنَّ كِتَٰبَ اَ۬لْفُجّ۪ارِ لَفِے سِجِّينٖۖ"},{"id":5831,"jozz":30,"page":"588","line_start":2,"line_end":2,"aya_no":8,"aya_text":"وَمَآ أَدْر۪يٰكَ مَا سِجِّينٞ"},{"id":5832,"jozz":30,"page":"588","line_start":2,"line_end":2,"aya_no":9,"aya_text":"كِتَٰبٞ مَّرْقُومٞۖ"},{"id":5833,"jozz":30,"page":"588","line_start":3,"line_end":3,"aya_no":10,"aya_text":" وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ"},{"id":5834,"jozz":30,"page":"588","line_start":3,"line_end":3,"aya_no":11,"aya_text":"اَ۬لذِينَ يُكَذِّبُونَ بِيَوْمِ اِ۬لدِّينِۖ"},{"id":5835,"jozz":30,"page":"588","line_start":3,"line_end":4,"aya_no":12,"aya_text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ اَثِيمٍ"},{"id":5836,"jozz":30,"page":"588","line_start":4,"line_end":5,"aya_no":13,"aya_text":"اِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ"},{"id":5837,"jozz":30,"page":"588","line_start":5,"line_end":5,"aya_no":14,"aya_text":"۞ كَلَّا بَل رَّانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكْسِبُونَۖ"},{"id":5838,"jozz":30,"page":