"line_start":13,"line_end":14,"aya_no":30,"aya_text":"وَإِذَا مَرُّواْ بِهِمْ يَتَغَامَزُونَ"},{"id":5854,"jozz":30,"page":"588","line_start":14,"line_end":14,"aya_no":31,"aya_text":"وَإِذَا اَ۪نقَلَبُوٓاْ إِلَىٰٓ أَهْلِهِمُ اُ۪نقَلَبُواْ فَٰكِهِينَ"},{"id":5855,"jozz":30,"page":"588","line_start":14,"line_end":15,"aya_no":32,"aya_text":"وَإِذَا رَأَوْهُمْ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ"},{"id":5856,"jozz":30,"page":"588","line_start":15,"line_end":15,"aya_no":33,"aya_text":"وَمَآ أُرْسِلُواْ عَلَيْهِمْ حَٰفِظِينَۖ"},{"id":5857,"jozz":30,"page":"589","line_start":1,"line_end":1,"aya_no":34,"aya_text":" فَالْيَوْمَ اَ۬لذِينَ ءَامَنُواْ مِنَ اَ۬لْكُفّ۪ارِ يَضْحَكُونَ"},{"id":5858,"jozz":30,"page":"589","line_start":1,"line_end":2,"aya_no":35,"aya_text":"عَلَى اَ۬لَارَآئِكِۖ يَنظُرُونَ"},{"id":5859,"jozz":30,"page":"589","line_start":2,"line_end":2,"aya_no":36,"aya_text":"هَلْ ثُوِّبَ اَ۬لْكُفَّارُ مَا كَانُواْ يَفْعَلُونَۖ"}]}