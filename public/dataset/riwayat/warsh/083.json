{"riwayah":"warsh","version":"10","sura_no":83,"sura_name_ar":"المُطَففين","sura_name_en":"Al-Muṭaffifīn","ayat":[{"jozz":30,"page":"587","aya_no":1,"aya_text":"وَيْلٞ لِّلْمُطَفِّفِينَ"},{"jozz":30,"page":"587","aya_no":2,"aya_text":"اَ۬لذِينَ إِذَا اَ۪كْتَالُواْ عَلَى اَ۬لنَّاسِ يَسْتَوْفُونَ"},{"jozz":30,"page":"587","aya_no":3,"aya_text":"وَإِذَا كَالُوهُمُۥٓ أَو وَّزَنُوهُمْ يُخْسِرُونَۖ"},{"jozz":30,"page":"587","aya_no":4,"aya_text":"أَلَا يَظُنُّ أُوْلَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ"},{"jozz":30,"page":"588","aya_no":5,"aya_text":" لِيَوْمٍ عَظِيمٖ"},{"jozz":30,"page":"588","aya_no":6,"aya_text":"يَوْمَ يَقُومُ اُ۬لنَّاسُ لِرَبِّ اِ۬لْعَٰلَمِينَۖ"},{"jozz":30,"page":"588","aya_no":7,"aya_text":"كَلَّآ إِنَّ كِتَٰبَ اَ۬لْفُجّ۪ارِ لَفِے سِجِّينٖۖ"},{"jozz":30,"page":"588","aya_no":8,"aya_text":"وَمَآ أَدْر۪يٰكَ مَا سِجِّينٞ"},{"jozz":30,"page":"588","aya_no":9,"aya_text":"كِتَٰبٞ مَّرْقُومٞۖ"},{"jozz":30,"page":"588","aya_no":10,"aya_text":" وَيْلٞ يَوْمَئِذٖ لِّلْمُكَذِّبِينَ"},{"jozz":30,"page":"588","aya_no":11,"aya_text":"اَ۬لذِينَ يُكَذِّبُونَ بِيَوْمِ اِ۬لدِّينِۖ"},{"jozz":30,"page":"588","aya_no":12,"aya_text":"وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ اَثِيمٍ"},{"jozz":30,"page":"588","aya_no":13,"aya_text":"اِذَا تُتْل۪ىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ اُ۬لَاوَّلِينَۖ"},{"jozz":30,"page":"588","aya_no":14,"aya_text":"۞ كَلَّا بَل رَّانَ عَلَىٰ قُلُوبِهِم مَّا كَانُواْ يَكْسِبُونَۖ"},{"jozz":30,"page":"588","aya_no":15,"aya_text":"كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٖ لَّمَحْجُوبُونَۖ"},{"jozz":30,"page":"588","aya_no":16,"aya_text":"ثُمَّ إِنَّهُمْ لَصَالُواْ اُ۬لْجَحِيمِۖ"},{"jozz":30,"page":"588","aya_no":17,"aya_text":" ثُمَّ يُقَالُ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ"},{"jozz":30,"page":"588","aya_no":18,"aya_text":"كَلَّآ إِنَّ كِتَٰبَ اَ۬لَابْر۪ارِ لَفِے عِلِّيِّينَۖ"},{"jozz":30,"page":"588","aya_no":19,"aya_text":"وَمَآ أَدْر۪يٰكَ مَا عِلِّيُّونَ"},{"jozz":30,"page":"588","aya_no":20,"aya_text":"كِتَٰبٞ مَّرْقُومٞ"},{"jozz":30,"page":"588","aya_no":21,"aya_text":" يَشْهَدُهُ اُ۬لْمُقَرَّبُونَۖ"},{"jozz":30,"page":"588","aya_no":22,"aya_text":"إِنَّ اَ۬لَابْرَارَ لَفِے نَعِيمٍ"},{"jozz":30,"page":"588","aya_no":23,"aya_text":"عَلَى اَ۬لَارَآئِكِ يَنظُرُونَ"},{"jozz":30,"page":"588","aya_no":24,"aya_text":"تَعْرِفُ فِے وُجُوهِهِمْ نَضْرَةَ اَ۬لنَّعِيمِ"},{"jozz":30,"page":"588","aya_no":25,"aya_text":"يُسْقَوْنَ مِن رَّحِيقٖ مَّخْتُومٍ"},{"jozz":30,"page":"588","aya_no":26,"aya_text":"خِتَٰمُهُۥ مِسْكٞۖ وَفِے ذَٰلِكَ فَلْيَتَنَافَسِ اِ۬لْمُتَنَٰفِسُونَۖ"},{"jozz":30,"page":"588","aya_no":27,"aya_text":" وَمِزَاجُهُۥ مِن تَسْنِيمٍ"},{"jozz":30,"page":"588","aya_no":28,"aya_text":"عَيْناٗ يَشْرَبُ بِهَا اَ۬لْمُقَرَّبُونَۖ"},{"jozz":30,"page":"588","aya_no":29,"aya_text":"إِنَّ اَ۬لذِينَ أَجْرَمُواْ كَانُواْ مِنَ اَ۬لذِينَ ءَامَنُواْ يَضْحَكُونَ"},{"jozz":30,"page":"588","aya_no":30,"aya_text":"وَإِذَا مَرُّواْ بِهِمْ يَتَغَامَزُونَ"},{"jozz":30,"page":"588","aya_no":31,"aya_text":"وَإِذَا اَ۪نقَلَبُوٓاْ إِلَىٰٓ أَهْلِهِمُ اُ۪نقَلَبُواْ فَٰكِهِينَ"},{"jozz":30,"page":"588","aya_no":32,"aya_text":"وَإِذَا رَأَوْهُمْ قَالُوٓاْ إِنَّ هَٰٓؤُلَآءِ لَضَآلُّونَ"},{"jozz":30,"page":"588","aya_no":33,"aya_text":"وَمَآ أُرْسِلُواْ عَلَيْهِمْ حَٰفِظِينَۖ"},{"jozz":30,"page":"589","aya_no":34,"aya_text":" فَالْيَوْمَ اَ۬لذِينَ ءَامَنُواْ مِنَ اَ۬لْكُفّ۪ارِ يَضْحَكُونَ"},{"jozz":30,"page":"589","aya_no":35,"aya_text":"عَلَى اَ۬لَارَآئِكِۖ يَنظُرُونَ"},{"jozz":30,"page":"589","aya_no":36,"aya_text":"هَلْ ثُوِّبَ اَ۬لْكُفَّارُ مَا كَانُواْ يَفْعَلُونَۖ"}]}