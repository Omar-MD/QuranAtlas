{"riwayah":"qaloon","version":"10","sura_no":97,"sura_name_ar":"القَدر","sura_name_en":"Al-Qadr","ayat":[{"id":6104,"jozz":30,"page":"598","line_start":6,"line_end":6,"aya_no":1,"aya_text":"إِنَّا أَنزَلْنَٰهُ فِے لَيْلَةِ اِ۬لْقَدْرِۖ ١"},{"id":6105,"jozz":30,"page":"598","line_start":6,"line_end":6,"aya_no":2,"aya_text":"وَمَا أَدْرَيٰكَ مَا لَيْلَةُ اُ۬لْقَدْرِۖ ٢"},{"id":6106,"jozz":30,"page":"598","line_start":7,"line_end":7,"aya_no":3,"aya_text":"لَيْلَةُ اُ۬لْقَدْرِ خَيْرٞ مِّنْ أَلْفِ شَهْرٖۖ ٣"},{"id":6107,"jozz":30,"page":"598","line_start":7,"line_end":8,"aya_no":4,"aya_text":"تَنَزَّلُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٖۖ ٤"},{"id":6108,"jozz":30,"page":"598","line_start":8,"line_end":8,"aya_no":5,"aya_text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطْلَعِ اِ۬لْفَجْرِۖ ٥"}]}