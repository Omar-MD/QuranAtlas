{"riwayah":"qaloon","version":"10","sura_no":70,"sura_name_ar":"المَعَارج","sura_name_en":"Al-Ma‘ārij","ayat":[{"id":5354,"jozz":29,"page":"568","line_start":11,"line_end":11,"aya_no":1,"aya_text":"سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ ١"},{"id":5355,"jozz":29,"page":"568","line_start":11,"line_end":11,"aya_no":2,"aya_text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٞ ٢"},{"id":5356,"jozz":29,"page":"568","line_start":12,"line_end":12,"aya_no":3,"aya_text":"مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ ٣"},{"id":5357,"jozz":29,"page":"568","line_start":12,"line_end":13,"aya_no":4,"aya_text":"تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ ٤"},{"id":5358,"jozz":29,"page":"568","line_start":13,"line_end":13,"aya_no":5,"aya_text":"فَاصْبِرْ صَبْراٗ جَمِيلاًۖ ٥"},{"id":5359,"jozz":29,"page":"568","line_start":13,"line_end":14,"aya_no":6,"aya_text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ ٦"},{"id":5360,"jozz":29,"page":"568","line_start":14,"line_end":14,"aya_no":7,"aya_text":"وَنَرَيٰهُ قَرِيباٗۖ ٧"},{"id":5361,"jozz":29,"page":"568","line_start":14,"line_end":14,"aya_no":8,"aya_text":"يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ ٨"},{"id":5362,"jozz":29,"page":"568","line_start":15,"line_end":15,"aya_no":9,"aya_text":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ ٩"},{"id":5363,"jozz":29,"page":"568","line_start":15,"line_end":15,"aya_no":10,"aya_text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيماٗ ١٠"},{"id":5364,"jozz":29,"page":"569","line_start":1,"line_end":1,"aya_no":11,"aya_text":"يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ ١١"},{"id":5365,"jozz":29,"page":"569","line_start":2,"line_end":2,"aya_no":12,"aya_text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ ١٢"},{"id":5366,"jozz":29,"page":"569","line_start":2,"line_end":2,"aya_no":13,"aya_text":"وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ ١٣"},{"id":5367,"jozz":29,"page":"569","line_start":2,"line_end":3,"aya_no":14,"aya_text":"وَمَن فِے اِ۬لْأَرْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ ١٤"},{"id":5368,"jozz":29,