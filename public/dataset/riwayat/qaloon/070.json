{"riwayah":"qaloon","version":"10","sura_no":70,"sura_name_ar":"المَعَارج","sura_name_en":"Al-Ma‘ārij","ayat":[{"jozz":29,"page":"568","aya_no":1,"aya_text":"سَالَ سَآئِلُۢ بِعَذَابٖ وَاقِعٖ"},{"jozz":29,"page":"568","aya_no":2,"aya_text":"لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٞ"},{"jozz":29,"page":"568","aya_no":3,"aya_text":"مِّنَ اَ۬للَّهِ ذِے اِ۬لْمَعَارِجِۖ"},{"jozz":29,"page":"568","aya_no":4,"aya_text":"تَعْرُجُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ إِلَيْهِ فِے يَوْمٖ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٖۖ"},{"jozz":29,"page":"568","aya_no":5,"aya_text":"فَاصْبِرْ صَبْراٗ جَمِيلاًۖ"},{"jozz":29,"page":"568","aya_no":6,"aya_text":"إِنَّهُمْ يَرَوْنَهُۥ بَعِيداٗ"},{"jozz":29,"page":"568","aya_no":7,"aya_text":"وَنَرَيٰهُ قَرِيباٗۖ"},{"jozz":29,"page":"568","aya_no":8,"aya_text":"يَوْمَ تَكُونُ اُ۬لسَّمَآءُ كَالْمُهْلِ"},{"jozz":29,"page":"568","aya_no":9,"aya_text":"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ"},{"jozz":29,"page":"568","aya_no":10,"aya_text":"وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيماٗ"},{"jozz":29,"page":"569","aya_no":11,"aya_text":"يُبَصَّرُونَهُمْۖ يَوَدُّ اُ۬لْمُجْرِمُ لَوْ يَفْتَدِے مِنْ عَذَابِ يَوْمَئِذِۢ بِبَنِيهِ"},{"jozz":29,"page":"569","aya_no":12,"aya_text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ"},{"jozz":29,"page":"569","aya_no":13,"aya_text":"وَفَصِيلَتِهِ اِ۬لتِے تُـْٔوِيهِ"},{"jozz":29,"page":"569","aya_no":14,"aya_text":"وَمَن فِے اِ۬لْأَرْضِ جَمِيعاٗ ثُمَّ يُنجِيهِ"},{"jozz":29,"page":"569","aya_no":15,"aya_text":"كَلَّاۖ إِنَّهَا لَظَىٰ"},{"jozz":29,"page":"569","aya_no":16,"aya_text":"نَزَّاعَةٞ لِّلشَّوَىٰ"},{"jozz":29,"page":"569","aya_no":17,"aya_text":"تَدْعُواْ مَنْ أَدْبَرَ وَتَوَلَّىٰ"},{"jozz":29,"page":"569","aya_no":18,"aya_text":"وَجَمَعَ فَأَوْعَىٰۖ"},{"jozz":29,"page":"569","aya_no":19,"aya_text":"۞ إِنَّ اَ۬لْإِنسَٰنَ خُلِقَ هَلُوعاً"},{"jozz":29,"page":"569","aya_no":20,"aya_text":"إِذَا مَسَّهُ اُ۬لشَّرُّ جَزُوعاٗ"},{"jozz":29,"page":"569","aya_no":21,"aya_text":"وَإِذَا مَسَّهُ اُ۬لْخَيْرُ مَنُوعاً"},{"jozz":29,"page":"569","aya_no":22,"aya_text":"إِلَّا اَ۬لْمُصَلِّينَ"},{"jozz":29,"page":"569","aya_no":23,"aya_text":"اَ۬لذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَۖ"},{"jozz":29,"page":"569","aya_no":24,"aya_text":"وَالذِينَ فِے أَمْوَٰلِهِمْ حَقّٞ مَّعْلُومٞ"},{"jozz":29,"page":"569","aya_no":25,"aya_text":"لِّلسَّآئِلِ وَالْمَحْرُومِۖ"},{"jozz":29,"page":"569","aya_no":26,"aya_text":"وَالذِينَ يُصَدِّقُونَ بِيَوْمِ اِ۬لدِّينِۖ"},{"jozz":29,"page":"569","aya_no":27,"aya_text":"وَالذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ"},{"jozz":29,"page":"569","aya_no":28,"aya_text":"إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٖۖ"},{"jozz":29,"page":"569","aya_no":29,"aya_text":"وَالذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ"},{"jozz":29,"page":"569","aya_no":30,"aya_text":"إِلَّا عَلَىٰ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَۖ"},{"jozz":29,"page":"569","aya_no":31,"aya_text":"فَمَنِ اِ۪بْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْعَادُونَۖ"},{"jozz":29,"page":"569","aya_no":32,"aya_text":"وَالذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَۖ"},{"jozz":29,"page":"569","aya_no":33,"aya_text":"وَالذِينَ هُم بِشَهَٰدَتِهِمْ قَآئِمُونَۖ"},{"jozz":29,"page":"569","aya_no":34,"aya_text":"وَالذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ"},{"jozz":29,"page":"569","aya_no":35,"aya_text":"أُوْلَٰٓئِكَ فِے جَنَّٰتٖ مُّكْرَمُونَۖ"},{"jozz":29,"page":"569","aya_no":36,"aya_text":"فَمَالِ اِ۬لذِينَ كَفَرُواْ قِبَلَكَ مُهْطِعِينَ"},{"jozz":29,"page":"569","aya_no":37,"aya_text":"عَنِ اِ۬لْيَمِينِ وَعَنِ اِ۬لشِّمَالِ عِزِينَۖ"},{"jozz":29,"page":"569","aya_no":38,"aya_text":"أَيَطْمَعُ كُلُّ اُ۪مْرِےٕٖ مِّنْهُمْ أَنْ يُّدْخَلَ جَنَّةَ نَعِيمٖ"},{"jozz":29,"page":"569","aya_no":39,"aya_text":"كَلَّاۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَۖ"},{"jozz":29,"page":"569","aya_no":40,"aya_text":"۞ فَلَا أُقْسِمُ بِرَبِّ اِ۬لْمَشَٰرِقِ وَالْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ"},{"jozz":29,"page":"570","aya_no":41,"aya_text":"عَلَىٰ أَن نُّبَدِّلَ خَيْراٗ مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَۖ"},{"jozz":29,"page":"570","aya_no":42,"aya_text":"فَذَرْهُمْ يَخُوضُواْ وَيَلْعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوْمَهُمُ اُ۬لذِے يُوعَدُونَ"},{"jozz":29,"page":"570","aya_no":43,"aya_text":"يَوْمَ يَخْرُجُونَ مِنَ اَ۬لْأَجْدَاثِ سِرَاعاٗ كَأَنَّهُمْ إِلَىٰ نَصْبٖ يُوفِضُونَ"},{"jozz":29,"page":"570","aya_no":44,"aya_text":"خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٞۖ ذَٰلِكَ اَ۬لْيَوْمُ اُ۬لذِے كَانُواْ يُوعَدُونَۖ"}]}