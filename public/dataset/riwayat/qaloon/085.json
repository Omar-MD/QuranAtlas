{"riwayah":"qaloon","version":"10","sura_no":85,"sura_name_ar":"البُرُوج","sura_name_en":"Al-Burūj","ayat":[{"jozz":30,"page":"590","aya_no":1,"aya_text":"وَالسَّمَآءِ ذَاتِ اِ۬لْبُرُوجِ"},{"jozz":30,"page":"590","aya_no":2,"aya_text":"وَالْيَوْمِ اِ۬لْمَوْعُودِ"},{"jozz":30,"page":"590","aya_no":3,"aya_text":"وَشَاهِدٖ وَمَشْهُودٖ"},{"jozz":30,"page":"590","aya_no":4,"aya_text":"قُتِلَ أَصْحَٰبُ اُ۬لْأُخْدُودِ"},{"jozz":30,"page":"590","aya_no":5,"aya_text":"اِ۬لنَّارِ ذَاتِ اِ۬لْوَقُودِ"},{"jozz":30,"page":"590","aya_no":6,"aya_text":"إِذْ هُمْ عَلَيْهَا قُعُودٞ"},{"jozz":30,"page":"590","aya_no":7,"aya_text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٞۖ"},{"jozz":30,"page":"590","aya_no":8,"aya_text":"وَمَا نَقَمُواْ مِنْهُمْ إِلَّا أَنْ يُّؤْمِنُواْ بِاللَّهِ اِ۬لْعَزِيزِ اِ۬لْحَمِيدِ"},{"jozz":30,"page":"590","aya_no":9,"aya_text":"اِ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالْأَرْضِۖ وَاللَّهُ عَلَىٰ كُلِّ شَےْءٖ شَهِيدٌۖ"},{"jozz":30,"page":"590","aya_no":10,"aya_text":"إِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُؤْمِنِينَ وَالْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ"},{"jozz":30,"page":"590","aya_no":11,"aya_text":"إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٞ تَجْرِے مِن تَحْتِهَا اَ۬لْأَنْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ"},{"jozz":30,"page":"590","aya_no":12,"aya_text":"۞ إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌۖ"},{"jozz":30,"page":"590","aya_no":13,"aya_text":"إِنَّهُۥ هُوَ يُبْدِۓُ وَيُعِيدُۖ"},{"jozz":30,"page":"590","aya_no":14,"aya_text":"وَهْوَ اَ۬لْغَفُورُ اُ۬لْوَدُودُ"},{"jozz":30,"page":"590","aya_no":15,"aya_text":"ذُو اُ۬لْعَرْشِۖ اِ۬لْمَجِيدُ"},{"jozz":30,"page":"590","aya_no":16,"aya_text":"فَعَّالٞ لِّمَا يُرِيدُۖ"},{"jozz":30,"page":"590","aya_no":17,"aya_text":"هَلْ أَتَيٰكَ حَدِيثُ اُ۬لْجُنُودِ"},{"jozz":30,"page":"590","aya_no":18,"aya_text":"فِرْعَوْنَ وَثَمُودَۖ"},{"jozz":30,"page":"590","aya_no":19,"aya_text":"بَلِ اِ۬لذِينَ كَفَرُواْ فِے تَكْذِيبٖ"},{"jozz":30,"page":"590","aya_no":20,"aya_text":"وَاللَّهُ مِنْ وَّرَآئِهِم مُّحِيطُۢۖ"},{"jozz":30,"page":"590","aya_no":21,"aya_text":"بَلْ هُوَ قُرْءَانٞ مَّجِيدٞ"},{"jozz":30,"page":"590","aya_no":22,"aya_text":"فِے لَوْحٖ مَّحْفُوظُۢۖ"}]}