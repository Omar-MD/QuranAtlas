{"riwayah":"warsh","version":"10","sura_no":111,"sura_name_ar":"المَسَد","sura_name_en":"Al-Masad","ayat":[{"jozz":30,"page":"603","aya_no":1,"aya_text":"تَبَّتْ يَدَآ أَبِے لَهَبٖ وَتَبَّۖ"},{"jozz":30,"page":"603","aya_no":2,"aya_text":"مَآ أَغْن۪ىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَۖ"},{"jozz":30,"page":"603","aya_no":3,"aya_text":" سَيَصْلَىٰ نَاراٗ ذَاتَ لَهَبٖ"},{"jozz":30,"page":"603","aya_no":4,"aya_text":"وَامْرَأَتُهُۥۖ حَمَّالَةُ اُ۬لْحَطَبِ"},{"jozz":30,"page":"603","aya_no":5,"aya_text":" فِے جِيدِهَا حَبْلٞ مِّن مَّسَدٖۖ"}]}