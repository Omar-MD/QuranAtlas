{"riwayah":"warsh","version":"10","sura_no":97,"sura_name_ar":"القَدر","sura_name_en":"Al-Qadr","ayat":[{"jozz":30,"page":"598","aya_no":1,"aya_text":"اِنَّآ أَنزَلْنَٰهُ فِے لَيْلَةِ اِ۬لْقَدْرِۖ"},{"jozz":30,"page":"598","aya_no":2,"aya_text":"وَمَآ أَدْر۪يٰكَ مَا لَيْلَةُ اُ۬لْقَدْرِۖ"},{"jozz":30,"page":"598","aya_no":3,"aya_text":" لَيْلَةُ اُ۬لْقَدْرِ خَيْرٞ مِّنَ اَلْفِ شَهْرٖۖ"},{"jozz":30,"page":"598","aya_no":4,"aya_text":"تَنَزَّلُ اُ۬لْمَلَٰٓئِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٖۖ"},{"jozz":30,"page":"598","aya_no":5,"aya_text":"سَلَٰمٌ هِيَ حَتَّىٰ مَطْلَعِ اِ۬لْفَجْرِۖ"}]}