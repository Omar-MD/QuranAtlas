{"riwayah":"warsh","version":"10","sura_no":84,"sura_name_ar":"الانشِقَاق","sura_name_en":"Al-Inshiqāq","ayat":[{"jozz":30,"page":"589","aya_no":1,"aya_text":"إِذَا اَ۬لسَّمَآءُ اُ۪نشَقَّتْ"},{"jozz":30,"page":"589","aya_no":2,"aya_text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ"},{"jozz":30,"page":"589","aya_no":3,"aya_text":"وَإِذَا اَ۬لَارْضُ مُدَّتْ"},{"jozz":30,"page":"589","aya_no":4,"aya_text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ"},{"jozz":30,"page":"589","aya_no":5,"aya_text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْۖ"},{"jozz":30,"page":"589","aya_no":6,"aya_text":" يَٰٓأَيُّهَا اَ۬لِانسَٰنُ إِنَّكَ كَادِحٌ اِلَىٰ رَبِّكَ كَدْحاٗ فَمُلَٰقِيهِۖ"},{"jozz":30,"page":"589","aya_no":7,"aya_text":"فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ"},{"jozz":30,"page":"589","aya_no":8,"aya_text":"فَسَوْفَ يُحَاسَبُ حِسَاباٗ يَسِيراٗ"},{"jozz":30,"page":"589","aya_no":9,"aya_text":" وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُوراٗۖ"},{"jozz":30,"page":"589","aya_no":10,"aya_text":"وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ"},{"jozz":30,"page":"589","aya_no":11,"aya_text":" فَسَوْفَ يَدْعُواْ ثُبُوراٗ"},{"jozz":30,"page":"589","aya_no":12,"aya_text":"وَيُصَلَّىٰ سَعِيراًۖ"},{"jozz":30,"page":"589","aya_no":13,"aya_text":"اِنَّهُۥ كَانَ فِےٓ أَهْلِهِۦ مَسْرُوراًۖ"},{"jozz":30,"page":"589","aya_no":14,"aya_text":"اِنَّهُۥ ظَنَّ أَن لَّنْ يَّحُورَ"},{"jozz":30,"page":"589","aya_no":15,"aya_text":"بَل۪ىٰٓۖ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيراٗۖ"},{"jozz":30,"page":"589","aya_no":16,"aya_text":" ۞ فَلَآ أُقْسِمُ بِالشَّفَقِ"},{"jozz":30,"page":"589","aya_no":17,"aya_text":"وَاليْلِ وَمَا وَسَقَ"},{"jozz":30,"page":"589","aya_no":18,"aya_text":"وَالْقَمَرِ إِذَا اَ۪تَّسَقَ"},{"jozz":30,"page":"589","aya_no":19,"aya_text":"لَتَرْكَبُنَّ طَبَقاً عَن طَبَقٖۖ"},{"jozz":30,"page":"589","aya_no":20,"aya_text":"فَمَا لَهُمْ لَا يُومِنُونَ"},{"jozz":30,"page":"589","aya_no":21,"aya_text":" وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَۖ"},{"jozz":30,"page":"589","aya_no":22,"aya_text":"بَلِ ا