{"riwayah":"qaloon","version":"10","sura_no":69,"sura_name_ar":"الحَاقة","sura_name_en":"Al-Ḥāqqah","ayat":[{"jozz":29,"page":"566","aya_no":1,"aya_text":"اِ۬لْحَآقَّةُ مَا اَ۬لْحَآقَّةُۖ"},{"jozz":29,"page":"566","aya_no":2,"aya_text":"وَمَا أَدْرَيٰكَ مَا اَ۬لْحَآقَّةُۖ"},{"jozz":29,"page":"566","aya_no":3,"aya_text":"كَذَّبَتْ ثَمُودُ وَعَادُۢ بِالْقَارِعَةِۖ"},{"jozz":29,"page":"566","aya_no":4,"aya_text":"فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ"},{"jozz":29,"page":"566","aya_no":5,"aya_text":"وَأَمَّا عَادٞ فَأُهْلِكُواْ بِرِيحٖ صَرْصَرٍ عَاتِيَةٖ"},{"jozz":29,"page":"566","aya_no":6,"aya_text":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٖ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماٗۖ فَتَرَى اَ۬لْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٖۖ"},{"jozz":29,"page":"566","aya_no":7,"aya_text":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٖۖ"},{"jozz":29,"page":"567","aya_no":8,"aya_text":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُؤْتَفِكَٰتُ بِالْخَاطِئَةِ"},{"jozz":29,"page":"567","aya_no":9,"aya_text":"فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةٗ رَّابِيَةًۖ"},{"jozz":29,"page":"567","aya_no":10,"aya_text":"إِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ"},{"jozz":29,"page":"567","aya_no":11,"aya_text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةٗ وَتَعِيَهَا أُذْنٞ وَٰعِيَةٞۖ"},{"jozz":29,"page":"567","aya_no":12,"aya_text":"فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةٞ وَٰحِدَةٞ"},{"jozz":29,"page":"567","aya_no":13,"aya_text":"وَحُمِلَتِ اِ۬لْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةٗ وَٰحِدَةٗ"},{"jozz":29,"page":"567","aya_no":14,"aya_text":"فَيَوْمَئِذٖ وَقَعَتِ اِ۬لْوَاقِعَةُ"},{"jozz":29,"page":"567","aya_no":15,"aya_text":"وَانشَقَّتِ اِ۬لسَّمَآءُ فَهْيَ يَوْمَئِذٖ وَاهِيَةٞ"},{"jozz":29,"page":"567","aya_no":16,"aya_text":"وَالْمَلَكُ عَلَىٰ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٖ ثَمَٰنِيَةٞ"},{"jozz":29,"page":"567","aya_no":17,"aya_text":"يَوْمَئِذٖ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٞۖ"},{"jozz":29,"page":"567","aya_no":18,"aya_text":"۞ فَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ"},{"jozz":29,"page":"567","aya_no":19,"aya_text":"إِنِّے ظَنَنتُ أَنِّے مُلَٰقٍ حِسَابِيَهْۖ"},{"jozz":29,"page":"567","aya_no":20,"aya_text":"فَهْوَ فِے عِيشَةٖ رَّاضِيَةٖ"},{"jozz":29,"page":"567","aya_no":21,"aya_text":"فِے جَنَّةٍ عَالِيَةٖ"},{"jozz":29,"page":"567","aya_no":22,"aya_text":"قُطُوفُهَا دَانِيَةٞۖ"},{"jozz":29,"page":"567","aya_no":23,"aya_text":"كُلُواْ وَاشْرَبُواْۖ هَنِيٓـٔاَۢ بِمَا أَسْلَفْتُمْ فِے اِ۬لْأَيَّامِ اِ۬لْخَالِيَةِۖ"},{"jozz":29,"page":"567","aya_no":24,"aya_text":"وَأَمَّا مَنْ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ"},{"jozz":29,"page":"567","aya_no":25,"aya_text":"فَيَقُولُ يَٰلَيْتَنِے لَمْ أُوتَ كِتَٰبِيَهْۖ"},{"jozz":29,"page":"567","aya_no":26,"aya_text":"وَلَمْ أَدْرِ مَا حِسَابِيَهْۖ"},{"jozz":29,"page":"567","aya_no":27,"aya_text":"يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ"},{"jozz":29,"page":"567","aya_no":28,"aya_text":"مَا أَغْنَىٰ عَنِّے مَالِيَهۖ"},{"jozz":29,"page":"567","aya_no":29,"aya_text":"هَّلَكَ عَنِّے سُلْطَٰنِيَهْۖ"},{"jozz":29,"page":"567","aya_no":30,"aya_text":"خُذُوهُ فَغُلُّوهُ"},{"jozz":29,"page":"567","aya_no":31,"aya_text":"ثُمَّ اَ۬لْجَحِيمَ صَلُّوهُ"},{"jozz":29,"page":"567","aya_no":32,"aya_text":"ثُمَّ فِے سِلْسِلَةٖ ذَرْعُهَا سَبْعُونَ ذِرَاعاٗ فَاسْلُكُوهُۖ"},{"jozz":29,"page":"567","aya_no":33,"aya_text":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِاللَّهِ اِ۬لْعَظِيمِ"},{"jozz":29,"page":"567","aya_no":34,"aya_text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ"},{"jozz":29,"page":"567","aya_no":35,"aya_text":"فَلَيْسَ لَهُ اُ۬لْيَوْمَ هَٰهُنَا حَمِيمٞ"},{"jozz":29,"page":"568","aya_no":36,"aya_text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٖ"},{"jozz":29,"page":"568","aya_no":37,"aya_text":"لَّا يَأْكُلُهُۥ إِلَّا اَ۬لْخَٰطِـُٔونَۖ"},{"jozz":29,"page":"568","aya_no":38,"aya_text":"۞ فَلَا أُقْسِمُ بِمَا تُبْصِرُونَ"},{"jozz":29,"page":"568","aya_no":39,"aya_text":"وَمَا لَا تُبْصِرُونَ"},{"jozz":29,"page":"568","aya_no":40,"aya_text":"إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ"},{"jozz":29,"page":"568","aya_no":41,"aya_text":"وَمَا هُوَ بِقَوْلِ شَاعِرٖ قَلِيلاٗ مَّا تُؤْمِنُونَ"},{"jozz":29,"page":"568","aya_no":42,"aya_text":"وَلَا بِقَوْلِ كَاهِنٖۖ قَلِيلاٗ مَّا تَذَّكَّرُونَۖ"},{"jozz":29,"page":"568","aya_no":43,"aya_text":"تَنزِيلٞ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ"},{"jozz":29,"page":"568","aya_no":44,"aya_text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ اَ۬لْأَقَاوِيلِ"},{"jozz":29,"page":"568","aya_no":45,"aya_text":"لَأَخَذْنَا مِنْهُ بِالْيَمِينِ"},{"jozz":29,"page":"568","aya_no":46,"aya_text":"ثُمَّ لَقَطَعْنَا مِنْهُ اُ۬لْوَتِينَ"},{"jozz":29,"page":"568","aya_no":47,"aya_text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَۖ"},{"jozz":29,"page":"568","aya_no":48,"aya_text":"وَإِنَّهُۥ لَتَذْكِرَةٞ لِّلْمُتَّقِينَۖ"},{"jozz":29,"page":"568","aya_no":49,"aya_text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَۖ"},{"jozz":29,"page":"568","aya_no":50,"aya_text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى اَ۬لْكَٰفِرِينَۖ"},{"jozz":29,"page":"568","aya_no":51,"aya_text":"وَإِنَّهُۥ لَحَقُّ اُ۬لْيَقِينِۖ"},{"jozz":29,"page":"568","aya_no":52,"aya_text":"فَسَبِّحْ بِاسْمِ رَبِّكَ اَ۬لْعَظِيمِۖ"}]}