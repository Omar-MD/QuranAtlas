{"riwayah":"hafs","version":"18","sura_no":85,"sura_name_ar":"البُرُوج","sura_name_en":"Al-Burūj","ayat":[{"jozz":30,"page":590,"aya_no":1,"aya_text":"وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ","id":5910,"line_start":4,"line_end":4},{"jozz":30,"page":590,"aya_no":2,"aya_text":"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ","id":5911,"line_start":4,"line_end":4},{"jozz":30,"page":590,"aya_no":3,"aya_text":"وَشَاهِدٖ وَمَشۡهُودٖ","id":5912,"line_start":4,"line_end":4},{"jozz":30,"page":590,"aya_no":4,"aya_text":"قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ","id":5913,"line_start":5,"line_end":5},{"jozz":30,"page":590,"aya_no":5,"aya_text":"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ","id":5914,"line_start":5,"line_end":5},{"jozz":30,"page":590,"aya_no":6,"aya_text":"إِذۡ هُمۡ عَلَيۡهَا قُعُودٞ","id":5915,"line_start":5,"line_end":6},{"jozz":30,"page":590,"aya_no":7,"aya_text":"وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودٞ","id":5916,"line_start":6,"line_end":6},{"jozz":30,"page":590,"aya_no":8,"aya_text":"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ","id":5917,"line_start":6,"line_end":7},{"jozz":30,"page":590,"aya_no":9,"aya_text":"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءٖ شَهِيدٌ","id":5918,"line_start":7,"line_end":8},{"jozz":30,"page":590,"aya_no":10,"aya_text":"إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ","id":5919,"line_start":8,"line_end":10},{"jozz":30,"page":590,"aya_no":11,"aya_text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتٞ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ","id":5920,"line_start":10,"line_end":11},{"jozz":30,"page":590,"aya_no":12,"aya_text":"إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ","id":5921,"line_start":11,"line_end":12},{"jozz":30,"page":590,"aya_no":13,"aya_text":"إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ","id":5922,"line_start":12,"line_end":12},{"jozz":30,"page":590,"aya_no":14,"aya_text":"وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ","id":5923,"line_start":12,"line_end":12},{"jozz":30,"page":590,"aya_no":15,"aya_text":"ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ","id":5924,"line_start":13,"line_end":13},{"jozz":30,"page":590,"aya_no":16,"aya_text":"فَعَّالٞ لِّمَا يُرِيدُ","id":5925,"line_start":13,"line_end":13},{"jozz":30,"page":590,"aya_no":17,"aya_text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ","id":5926,"line_start":13,"line_end":14},{"jozz":30,"page":590,"aya_no":18,"aya_text":"فِرۡعَوۡنَ وَثَمُودَ","id":5927,"line_start":14,"line_end":14},{"jozz":30,"page":590,"aya_no":19,"aya_text":"بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبٖ","id":5928,"line_start":14,"line_end":14},{"jozz":30,"page":590,"aya_no":20,"aya_text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ","id":5929,"line_start":14,"line_end":15},{"jozz":30,"page":590,"aya_no":21,"aya_text":"بَلۡ هُوَ قُرۡءَانٞ مَّجِيدٞ","id":5930,"line_start":15,"line_end":15},{"jozz":30,"page":590,"aya_no":22,"aya_text":"فِي لَوۡحٖ مَّحۡفُوظِۭ","id":5931,"line_start":15,"line_end":15}]}